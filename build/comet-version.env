# Central pins for the Comet executable bundled with the Retromind AppImage.
# The fork preserves bounded --credentials-stdin input and restores pending
# gameplay synchronization after restart. Both source archives are verified
# before the locked Rust build.
COMET_VERSION=0.4.1
COMET_FORK_RELEASE=retromind-v0.4.1-1
COMET_SOURCE_COMMIT=4fcf45d9c457058a6ed93346ea64569123ab81cd
COMET_SOURCE_SHA256=c441ddbdf606f39229251fdbdc28b2f7eb2841ad946dc15f73078a0d872dac80

# Comet's proto directory is a git submodule and is absent from GitHub's
# generated parent-repository source archive, so it is pinned independently.
COMET_PROTOCOLS_COMMIT=923e8a0008603365d29002db611559190da5bf99
COMET_PROTOCOLS_SOURCE_SHA256=03fb8fa6c22b72f1b91a4008c6ae6dcc1f02a6201b09d37f070883c2aafa5de1

# Exact official Rust 1.94.0 Bookworm image used for validation and AppImage builds.
# Comet 0.4.1's SQLx 0.9 dependency requires Rust >= 1.94.
COMET_RUST_IMAGE=rust@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f
