# Central pins for the Comet executable bundled with the Retromind AppImage.
# The fork commit provides the bounded --credentials-stdin contract required
# by Retromind. Both source archives are verified before the locked Rust build.
COMET_VERSION=0.3.2
COMET_FORK_RELEASE=retromind-v0.3.2-2
COMET_SOURCE_COMMIT=c496bd8683088b1f5baf8f05d1900c6c0431a74c
COMET_SOURCE_SHA256=154c114f61a382f027824c2945f998bbd5d8397fdff7a8ea7181aa85f7af3da2

# Comet's proto directory is a git submodule and is absent from GitHub's
# generated parent-repository source archive, so it is pinned independently.
COMET_PROTOCOLS_COMMIT=923e8a0008603365d29002db611559190da5bf99
COMET_PROTOCOLS_SOURCE_SHA256=03fb8fa6c22b72f1b91a4008c6ae6dcc1f02a6201b09d37f070883c2aafa5de1

# Exact official Rust image used for validation and AppImage builds.
COMET_RUST_IMAGE=rust@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f
