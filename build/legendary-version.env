# Central pin for the Legendary executable bundled with the Retromind AppImage.
# Updating Legendary should require changes only in this file plus the usual
# build/test review. Both downloaded archives are verified before use.
LEGENDARY_VERSION=0.21.1
LEGENDARY_SOURCE_COMMIT=42f6bdeadde3a9526dc8eb713763476999ac217b
LEGENDARY_SOURCE_SHA256=9eafe62abe856e692f5d963d908143b68cec749366fb704106efdca31491905e

# uv is used only inside the Debian builder. Legendary's own uv.lock pins and
# verifies the Python packages that are compiled into the standalone binary.
UV_VERSION=0.11.33
UV_X86_64_LINUX_GNU_SHA256=aa9fca823c03289fb6e3460b3dc864f3ea895cafaf9b99247701a67b17d1b018
