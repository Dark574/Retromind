# syntax=docker/dockerfile:1
# The canonical build script passes this value from build/comet-version.env.
# Keep the same pinned default so direct Dockerfile builds remain valid.
ARG COMET_RUST_IMAGE=rust@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f
FROM ${COMET_RUST_IMAGE} AS comet-builder

COPY build/comet-version.env /tmp/comet-version.env

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    . /tmp/comet-version.env; \
    comet_archive=/tmp/comet-source.tar.gz; \
    protocols_archive=/tmp/comet-protocols.tar.gz; \
    curl --fail --location --retry 5 --retry-delay 2 --retry-connrefused \
      -o "$comet_archive" \
      "https://github.com/Dark574/comet/archive/${COMET_SOURCE_COMMIT}.tar.gz"; \
    printf '%s  %s\n' "$COMET_SOURCE_SHA256" "$comet_archive" | sha256sum --check --strict; \
    mkdir -p /workspace; \
    tar -xzf "$comet_archive" -C /workspace --strip-components=1; \
    test "$(sed -n 's/^version = "\([^"]*\)"/\1/p' /workspace/Cargo.toml | head -n 1)" = "$COMET_VERSION"; \
    curl --fail --location --retry 5 --retry-delay 2 --retry-connrefused \
      -o "$protocols_archive" \
      "https://github.com/Yepoleb/gog_protocols/archive/${COMET_PROTOCOLS_COMMIT}.tar.gz"; \
    printf '%s  %s\n' "$COMET_PROTOCOLS_SOURCE_SHA256" "$protocols_archive" | sha256sum --check --strict; \
    rm -rf /workspace/proto; \
    mkdir -p /workspace/proto; \
    tar -xzf "$protocols_archive" -C /workspace/proto --strip-components=1; \
    rm -f "$comet_archive" "$protocols_archive"

RUN --mount=type=cache,id=retromind-comet-cargo-home,target=/tmp/comet-cargo,sharing=locked \
    --mount=type=cache,id=retromind-comet-target,target=/tmp/comet-target,sharing=locked \
    set -eu; \
    . /tmp/comet-version.env; \
    cd /workspace; \
    CARGO_HOME=/tmp/comet-cargo CARGO_TARGET_DIR=/tmp/comet-target CARGO_INCREMENTAL=0 \
      cargo build --release --locked; \
    mkdir -p /out/licenses; \
    cp /tmp/comet-target/release/comet /out/comet; \
    chmod +x /out/comet; \
    cp LICENSE /out/licenses/Comet.Apache-2.0.txt; \
    cp proto/LICENSE /out/licenses/GOG-Protocols.CC0-1.0.txt; \
    test "$(/out/comet --version)" = "comet ${COMET_VERSION}"; \
    /out/comet --help | grep -F -- '--credentials-stdin'; \
    set +e; \
    probe_output="$(printf '%s' '{"access_token":"DO_NOT_ECHO_SENTINEL"}' \
      | XDG_CONFIG_HOME=/tmp/comet-config /out/comet --credentials-stdin 2>&1)"; \
    probe_status=$?; \
    set -e; \
    test "$probe_status" -eq 2; \
    if printf '%s' "$probe_output" | grep -F 'DO_NOT_ECHO_SENTINEL'; then \
      echo 'Comet echoed credential input during its rejection probe.' >&2; \
      exit 1; \
    fi

FROM debian:bookworm AS legendary-builder

COPY build/legendary-version.env /tmp/legendary-version.env

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       binutils \
       ca-certificates \
       curl \
       libpython3.11 \
       python3 \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    . /tmp/legendary-version.env; \
    legendary_archive=/tmp/legendary-source.tar.gz; \
    uv_archive=/tmp/uv.tar.gz; \
    curl --fail --location --retry 5 --retry-delay 2 --retry-connrefused \
      -o "$legendary_archive" \
      "https://github.com/legendary-gl/legendary/archive/${LEGENDARY_SOURCE_COMMIT}.tar.gz"; \
    printf '%s  %s\n' "$LEGENDARY_SOURCE_SHA256" "$legendary_archive" | sha256sum --check --strict; \
    mkdir -p /build/legendary; \
    tar -xzf "$legendary_archive" -C /build/legendary --strip-components=1; \
    test "$(sed -n 's/^version = "\([^"]*\)"/\1/p' /build/legendary/pyproject.toml | head -n 1)" = "$LEGENDARY_VERSION"; \
    curl --fail --location --retry 5 --retry-delay 2 --retry-connrefused \
      -o "$uv_archive" \
      "https://releases.astral.sh/github/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz"; \
    printf '%s  %s\n' "$UV_X86_64_LINUX_GNU_SHA256" "$uv_archive" | sha256sum --check --strict; \
    mkdir -p /opt/uv; \
    tar -xzf "$uv_archive" -C /opt/uv --strip-components=1; \
    /opt/uv/uv --version; \
    rm -f "$legendary_archive" "$uv_archive"

ENV UV_PYTHON_DOWNLOADS=never
ENV UV_LINK_MODE=copy

RUN set -eu; \
    . /tmp/legendary-version.env; \
    cd /build/legendary; \
    /opt/uv/uv sync --frozen --no-dev --extra pyinstaller_build; \
    PYTHONOPTIMIZE=1 .venv/bin/python -m PyInstaller \
      --onefile \
      --name legendary \
      --strip \
      --paths /build/legendary \
      --copy-metadata legendary-gl \
      legendary/cli.py; \
    mkdir -p /out/licenses/Python /out/licenses/Python-Packages; \
    cp dist/legendary /out/legendary; \
    chmod +x /out/legendary; \
    cp LICENSE /out/licenses/Legendary.GPL-3.0-or-later.txt; \
    cp /usr/share/doc/python3.11/copyright /out/licenses/Python/Debian-copyright; \
    site_packages="$(find .venv/lib -type d -name site-packages -print -quit)"; \
    test -n "$site_packages"; \
    find "$site_packages" -type f \
      \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) \
      -print | while IFS= read -r license_file; do \
        relative_path="${license_file#"$site_packages"/}"; \
        destination="/out/licenses/Python-Packages/$relative_path"; \
        mkdir -p "$(dirname "$destination")"; \
        cp "$license_file" "$destination"; \
      done; \
    output="$(/out/legendary --version)"; \
    printf '%s\n' "$output"; \
    printf '%s\n' "$output" | grep -F "legendary version \"${LEGENDARY_VERSION}\""

FROM debian:bookworm

LABEL org.retromind.appimage-builder="true"

# Full AppImage build toolchain in Debian 12 (bookworm):
# - dotnet publish (self-contained)
# - VLC / LibVLC runtime export
# - optional helper tools (ffplay, sidplayfp) + runtime deps
# - Linux runtime libs needed by Retromind
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="${DOTNET_ROOT}:${PATH}"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
ENV DOTNET_NOLOGO=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       build-essential \
       curl \
       ffmpeg \
       libsecret-tools \
       sidplayfp \
       vlc \
       libvlc-dev \
       libavcodec-dev \
       libavformat-dev \
       libavutil-dev \
       libswresample-dev \
       libswscale-dev \
       libwayland-client0 \
       libwayland-cursor0 \
       libwayland-egl1 \
       libxkbcommon0 \
       libdecor-0-0 \
       libsdl2-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 10.0 --install-dir "$DOTNET_ROOT" \
    && ln -sf "$DOTNET_ROOT/dotnet" /usr/bin/dotnet \
    && dotnet --info \
    && rm -f /tmp/dotnet-install.sh

WORKDIR /src
COPY . /src

ARG RETROMIND_SCREENSCRAPER_BUILD_REVISION=none
RUN --mount=type=secret,id=retromind_screenscraper_developer_id,required=false \
    --mount=type=secret,id=retromind_screenscraper_developer_password,required=false \
    export RETROMIND_SCREENSCRAPER_DEVELOPER_ID="$(cat /run/secrets/retromind_screenscraper_developer_id 2>/dev/null || true)"; \
    export RETROMIND_SCREENSCRAPER_DEVELOPER_PASSWORD="$(cat /run/secrets/retromind_screenscraper_developer_password 2>/dev/null || true)"; \
    test -n "$RETROMIND_SCREENSCRAPER_BUILD_REVISION"; \
    dotnet publish Retromind.csproj -c Release -r linux-x64 \
      --self-contained true \
      -p:PublishSingleFile=true \
      -p:IncludeNativeLibrariesForSelfExtract=true \
      -p:PublishTrimmed=false

RUN set -eu; \
    mkdir -p /out/publish /out/vlc/lib /out/tools/bin /out/tools/lib /out/runtime-libs; \
    cp -a /src/bin/Release/net10.0/linux-x64/publish/. /out/publish/; \
    \
    # VLC plugins + LibVLC core
    cp -a /usr/lib/x86_64-linux-gnu/vlc /out/vlc/; \
    cp -a /usr/lib/x86_64-linux-gnu/libvlc.so*     /out/vlc/lib/; \
    cp -a /usr/lib/x86_64-linux-gnu/libvlccore.so* /out/vlc/lib/; \
    \
    # FFmpeg core + common codec/container libs used by VLC in this image
    cp -a /usr/lib/x86_64-linux-gnu/libavcodec.so*    /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libavformat.so*   /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libavutil.so*     /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libswresample.so* /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libswscale.so*    /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libvpx.so*        /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libjpeg.so*       /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libtheora*.so*    /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libcodec2.so*     /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libjxl*.so*       /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/librav1e.so*      /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libshine.so*      /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libSvtAv1Enc.so*  /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libx264.so*       /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libx265.so*       /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libFLAC.so*       /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libdav1d.so*      /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libvorbis*.so*    /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libopus.so*       /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libogg.so*        /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libmp3lame.so*    /out/vlc/lib/ || true; \
    cp -a /usr/lib/x86_64-linux-gnu/libidn.so*        /out/vlc/lib/ || true; \
    \
    # Drop VDPAU plugin tree to keep bundle size/deps lower.
    rm -rf /out/vlc/vlc/plugins/vdpau; \
    \
    # Drop optional plugins that pull additional dependencies we do not need
    # for Retromind's local preview use-cases.
    rm -f /out/vlc/vlc/plugins/codec/libsdl_image_plugin.so; \
    rm -f /out/vlc/vlc/plugins/codec/liba52_plugin.so; \
    rm -f /out/vlc/vlc/plugins/access/libcdda_plugin.so; \
    rm -f /out/vlc/vlc/plugins/services_discovery/libupnp_plugin.so; \
    rm -f /out/vlc/vlc/plugins/control/liblirc_plugin.so; \
    rm -f /out/vlc/vlc/plugins/lua/liblua_plugin.so; \
    rm -f /out/vlc/vlc/plugins/access/libnfs_plugin.so; \
    rm -f /out/vlc/vlc/plugins/demux/libmod_plugin.so; \
    rm -f /out/vlc/vlc/plugins/stream_out/libstream_out_chromecast_plugin.so; \
    rm -f /out/vlc/vlc/plugins/demux/libsid_plugin.so; \
    rm -f /out/vlc/vlc/plugins/audio_filter/libspatialaudio_plugin.so; \
    rm -f /out/vlc/vlc/plugins/meta_engine/libtaglib_plugin.so; \
    \
    copy_binary_deps() { \
      bin="$1"; \
      ldd "$bin" 2>/dev/null \
        | awk '\
            /=>/ { if ($3 ~ /^\//) print $3 } \
            /^[[:space:]]*\/[^[:space:]]+/ { print $1 } \
          ' \
        | while IFS= read -r dep; do \
            [ -n "$dep" ] || continue; \
            [ -e "$dep" ] || continue; \
            case "$dep" in \
              */ld-linux-*|*/libc.so.6|*/libm.so.6|*/libpthread.so.0|*/librt.so.1|*/libdl.so.2|*/libgcc_s.so.1|*/libstdc++.so.6) \
                continue \
                ;; \
            esac; \
            cp -L "$dep" /out/tools/lib/ || true; \
          done; \
    }; \
    \
    copy_vlc_deps() { \
      obj="$1"; \
      ldd "$obj" 2>/dev/null \
        | awk '\
            /=>/ { if ($3 ~ /^\//) print $3 } \
            /^[[:space:]]*\/[^[:space:]]+/ { print $1 } \
          ' \
        | while IFS= read -r dep; do \
            [ -n "$dep" ] || continue; \
            [ -e "$dep" ] || continue; \
            case "$dep" in \
              */ld-linux-*|*/libc.so.6|*/libm.so.6|*/libpthread.so.0|*/librt.so.1|*/libdl.so.2|*/libgcc_s.so.1|*/libstdc++.so.6) \
                continue \
                ;; \
              # Keep font stack on host to avoid bundled-fontconfig vs host-config mismatches.
              */libfontconfig.so*|*/libfreetype.so*|*/libharfbuzz.so*|*/libfribidi.so*|*/libexpat.so*) \
                continue \
                ;; \
            esac; \
            cp -L "$dep" /out/vlc/lib/ || true; \
          done; \
    }; \
    \
    # Ensure VLC video/audio plugins can resolve all their dependencies without host libraries.
    find /out/vlc/lib -maxdepth 1 -type f -name "libvlc*.so*" -print | while IFS= read -r lib; do \
      [ -n "$lib" ] || continue; \
      copy_vlc_deps "$lib"; \
    done; \
    find /out/vlc/vlc/plugins -type f -name "*.so" -print | while IFS= read -r plugin; do \
      [ -n "$plugin" ] || continue; \
      copy_vlc_deps "$plugin"; \
    done; \
    \
    previous_vlc_count=-1; \
    while :; do \
      current_vlc_count="$(find /out/vlc/lib -maxdepth 1 -type f | wc -l)"; \
      if [ "$current_vlc_count" = "$previous_vlc_count" ]; then \
        break; \
      fi; \
      previous_vlc_count="$current_vlc_count"; \
      find /out/vlc/lib -maxdepth 1 -type f -print | while IFS= read -r lib; do \
        [ -n "$lib" ] || continue; \
        copy_vlc_deps "$lib"; \
      done; \
    done; \
    \
    bundle_tool() { \
      tool_name="$1"; \
      shift; \
      resolved=""; \
      for candidate in "$@"; do \
        if [ -x "$candidate" ]; then \
          resolved="$candidate"; \
          break; \
        fi; \
      done; \
      if [ -z "$resolved" ]; then \
        echo "Notice: tool '$tool_name' not found in image."; \
        return 0; \
      fi; \
      cp "$resolved" "/out/tools/bin/$tool_name"; \
      chmod +x "/out/tools/bin/$tool_name"; \
      copy_binary_deps "$resolved"; \
    }; \
    \
    bundle_tool sidplayfp /usr/bin/sidplayfp /usr/games/sidplayfp; \
    bundle_tool ffplay /usr/bin/ffplay; \
    bundle_tool secret-tool /usr/bin/secret-tool; \
    \
    # Close transitive dependency chains for bundled helper tools.
    # Without this, helpers can still end up requiring host libraries on some systems.
    previous_count=-1; \
    while :; do \
      current_count="$(find /out/tools/lib -maxdepth 1 -type f | wc -l)"; \
      if [ "$current_count" = "$previous_count" ]; then \
        break; \
      fi; \
      previous_count="$current_count"; \
      find /out/tools/lib -maxdepth 1 -type f -print | while IFS= read -r lib; do \
        [ -n "$lib" ] || continue; \
        copy_binary_deps "$lib"; \
      done; \
    done; \
    \
    copy_runtime_lib() { \
      name="$1"; \
      path=""; \
      for dir in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib /lib; do \
        if [ -e "$dir/$name" ]; then \
          path="$dir/$name"; \
          break; \
        fi; \
      done; \
      if [ -n "$path" ]; then \
        cp -L "$path" /out/runtime-libs/; \
      else \
        echo "Notice: runtime lib '$name' not found in image."; \
      fi; \
    }; \
    \
    copy_runtime_lib libwayland-client.so.0; \
    copy_runtime_lib libwayland-cursor.so.0; \
    copy_runtime_lib libwayland-egl.so.1; \
    copy_runtime_lib libxkbcommon.so.0; \
    copy_runtime_lib libdecor-0.so.0; \
    copy_runtime_lib libSDL2-2.0.so.0; \
    \
    copy_runtime_lib_with_deps() { \
      lib_path="$1"; \
      cp -L "$lib_path" /out/runtime-libs/; \
      ldd "$lib_path" 2>/dev/null \
        | awk '\
            /=>/ { if ($3 ~ /^\//) print $3 } \
            /^[[:space:]]*\/[^[:space:]]+/ { print $1 } \
          ' \
        | while IFS= read -r dep; do \
            [ -n "$dep" ] || continue; \
            [ -e "$dep" ] || continue; \
            case "$dep" in \
              */ld-linux-*|*/libc.so.6|*/libm.so.6|*/libpthread.so.0|*/librt.so.1|*/libdl.so.2|*/libgcc_s.so.1|*/libstdc++.so.6) \
                continue \
                ;; \
            esac; \
            cp -L "$dep" /out/runtime-libs/ || true; \
          done; \
    }; \
    \
    resolve_first_matching_lib() { \
      pattern="$1"; \
      for dir in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib /lib; do \
        for candidate in "$dir"/$pattern; do \
          if [ -e "$candidate" ]; then \
            printf '%s\n' "$candidate"; \
            return 0; \
          fi; \
        done; \
      done; \
      return 1; \
    }; \
    \
    true

COPY --from=legendary-builder /out/legendary /out/tools/bin/legendary
COPY --from=legendary-builder /out/licenses /out/legendary-licenses
COPY --from=comet-builder /out/comet /out/tools/bin/comet
COPY --from=comet-builder /out/licenses /out/comet-licenses

CMD ["bash", "-lc", "echo 'Retromind bookworm builder image ready.'"]
