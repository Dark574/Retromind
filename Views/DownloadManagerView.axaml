<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Retromind.ViewModels"
        xmlns:p="clr-namespace:Retromind.Resources"
        x:Class="Retromind.Views.DownloadManagerView"
        x:DataType="vm:DownloadManagerViewModel"
        Title="{x:Static p:DownloadStrings.Title}"
        Width="1140" Height="550" MinWidth="700" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        ShowInTaskbar="False"
        CanMinimize="False"
        CanMaximize="False">
    <Grid Margin="14,0,14,14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Height="30">
            <Border Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
                <TextBlock Text="{x:Static p:DownloadStrings.Title}" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Border>
            <Button Grid.Column="1" Width="36" Height="30" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="Transparent" BorderThickness="0" Click="OnCloseClicked"
                    AutomationProperties.Name="{x:Static p:Strings.Button_Close}"
                    ToolTip.Tip="{x:Static p:Strings.Button_Close}">
                <PathIcon Width="12" Height="12"
                          Data="M1,0 L6,5 L11,0 L12,1 L7,6 L12,11 L11,12 L6,7 L1,12 L0,11 L5,6 L0,1 Z" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel IsVisible="{Binding HasSelectedGame}" Spacing="6">
                <TextBlock Text="{Binding SelectedGameTitle}" FontWeight="SemiBold" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                    <Button Content="{x:Static p:DownloadStrings.AddUpdate}" Command="{Binding AddUpdate}" />
                    <Button Content="{x:Static p:DownloadStrings.AddWindows}" Command="{Binding AddWindowsInstaller}" />
                    <Button Content="{x:Static p:DownloadStrings.AddLinux}" Command="{Binding AddLinuxInstaller}" />
                    <CheckBox Content="{x:Static p:DownloadStrings.Exclude}" IsChecked="{Binding Excluded}" />
                </WrapPanel>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{Binding QueuePauseLabel}"
                    Command="{Binding ToggleQueuePause}" ToolTip.Tip="{x:Static p:DownloadStrings.QueuePauseHint}" />
        </Grid>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadManagerViewModel+Entry">
                        <Grid ColumnDefinitions="2*,1*,2*" ColumnSpacing="14" Margin="2,4">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Store}" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Kind}" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}"
                                             IsIndeterminate="{Binding Indeterminate}" IsVisible="{Binding IsActive}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Data}" />
                                    <TextBlock Text="{Binding Speed}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock IsVisible="{Binding IsEmpty}" Text="{x:Static p:DownloadStrings.Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock IsVisible="{Binding QueueUnavailable}" Text="{x:Static p:DownloadStrings.Unavailable}"
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="30" />
        </Grid>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static p:DownloadStrings.Start}" Command="{Binding Start}" />
                <Button Content="{x:Static p:DownloadStrings.Pause}" Command="{Binding Pause}" />
                <Button Content="{x:Static p:DownloadStrings.Resume}" Command="{Binding Resume}" />
                <Button Content="{x:Static p:DownloadStrings.Cancel}" Command="{Binding Cancel}" />
                <Button Content="{x:Static p:DownloadStrings.Retry}" Command="{Binding Retry}" />
                <Button Content="{x:Static p:DownloadStrings.Install}" Command="{Binding Install}" />
                <Button Content="{x:Static p:DownloadStrings.Repair}" Command="{Binding Repair}" />
                <Button Content="{x:Static p:DownloadStrings.Earlier}" Command="{Binding Earlier}" />
                <Button Content="{x:Static p:DownloadStrings.Later}" Command="{Binding Later}" />
                <Button Content="{x:Static p:DownloadStrings.Remove}" Command="{Binding Remove}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
