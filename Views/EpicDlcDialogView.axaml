<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Retromind.ViewModels"
        x:Class="Retromind.Views.EpicDlcDialogView"
        x:DataType="vm:EpicDlcDialogViewModel"
        Title="{Binding DialogTitleText}"
        Width="900"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        CanMaximize="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="17"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding SummaryText}"
                       Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,220,Auto"
              Margin="0,0,0,12"
              IsEnabled="{Binding IsInteractionEnabled}">
            <TextBox Grid.Column="0"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding SearchPlaceholderText}" />
            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      Height="32"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EpicDlcFilterOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Content="{Binding RefreshText}"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="2" IsEnabled="{Binding IsInteractionEnabled}">
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="4"
                    IsVisible="{Binding ShowList}">
                <ListBox ItemsSource="{Binding FilteredDlcs}"
                         SelectedItem="{Binding SelectedDlc, Mode=TwoWay}"
                         Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EpicDlcCatalogEntry">
                            <Border CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <Border Background="#187BA3FF"
                                            BorderBrush="#7BA3FF"
                                            BorderThickness="3,0,0,0"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding IsInstalled}" />
                                    <Grid ColumnDefinitions="*,240" Margin="10,6,7,6">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AppName}"
                                                       FontSize="11"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding StatusText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Opacity="0.8" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel IsVisible="{Binding IsLoading}"
                        Width="320"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="5" />
                <TextBlock Text="{Binding LoadingText}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasError}"
                        MaxWidth="600"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button Content="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock IsVisible="{Binding ShowEmptyState}"
                       Text="{Binding EmptyStateText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.75" />

            <ProgressBar IsVisible="{Binding IsOperating}"
                         IsIndeterminate="{Binding IsOperating}"
                         Height="4"
                         VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,16,0,0"
              ColumnDefinitions="*,Auto,Auto,Auto">
            <Button Grid.Column="1"
                    Margin="0,0,8,0"
                    Content="{Binding InstallText}"
                    Command="{Binding InstallSelectedCommand}"
                    IsEnabled="{Binding CanInstallSelected}" />
            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Content="{Binding UninstallText}"
                    Command="{Binding UninstallSelectedCommand}"
                    IsEnabled="{Binding CanUninstallSelected}"
                    Foreground="Red" />
            <Button Grid.Column="3"
                    Content="{Binding CloseText}"
                    Command="{Binding CloseCommand}"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
