<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="using:System"
        xmlns:p="clr-namespace:Retromind.Resources"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
        x:Class="Retromind.Views.InfoView"
        x:Name="InfoDialog"
        x:DataType="sys:String"
        Title="{x:Static p:Strings.Dialog_TitleConfirm}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        CanMaximize="False">

    <StackPanel Margin="20" Spacing="20">
        <ScrollViewer MaxHeight="500"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding}"
                                 FontSize="16"
                                 TextWrapping="Wrap"
                                 MaxWidth="520" />
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{x:Static p:Strings.Button_Copy}"
                    Click="OnCopyClick"
                    IsVisible="{Binding #InfoDialog.ShowCopyButton}"
                    Width="90" />
            <Button Content="{x:Static p:Strings.Button_Ok}"
                    Click="OnOkClick"
                    IsDefault="True"
                    IsCancel="True"
                    Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
