<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Retromind.ViewModels"
        xmlns:views="clr-namespace:Retromind.Views"
        x:Class="Retromind.Views.BulkEditMediaView"
        x:DataType="vm:BulkEditMediaViewModel"
        Title="{Binding DialogTitle}"
        Width="760"
        Height="650"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        CanMaximize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,18">
            <TextBlock Text="{Binding ItemCountText}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding HintText}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="{Binding MetadataTabTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="10,14,16,10">
                        <TextBlock Text="{Binding MetadataHint}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="155,145,*" ColumnSpacing="10">
                            <TextBlock Text="{Binding StatusText}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding StatusOperationOptions}"
                                      SelectedItem="{Binding SelectedStatusOperation}"
                                      DisplayMemberBinding="{Binding Label}" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}"
                                      DisplayMemberBinding="{Binding Label}"
                                      IsEnabled="{Binding IsStatusSetOperation}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TextMetadataFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BulkTextMetadataPatchRow">
                                    <Grid ColumnDefinitions="155,145,*"
                                          ColumnSpacing="10"
                                          Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Label}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding OperationOptions}"
                                                  SelectedItem="{Binding SelectedOperation}"
                                                  DisplayMemberBinding="{Binding Label}" />
                                        <views:MetadataAutoCompleteTextBox Grid.Column="2"
                                                                           Text="{Binding Value}"
                                                                           SuggestionSuffix="{Binding SuggestionSuffix}"
                                                                           AcceptSuggestionCommand="{Binding AcceptSuggestionCommand}"
                                                                           IsEnabled="{Binding IsSetOperation}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding CustomFieldsTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="10,14,16,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding CustomFieldsHint}"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{Binding AddCustomFieldText}"
                                    Command="{Binding AddCustomFieldPatchCommand}"
                                    Margin="12,0,0,0" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CustomFieldPatches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BulkCustomFieldPatchRow">
                                    <Grid ColumnDefinitions="120,*,*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,0,0,7">
                                        <ComboBox ItemsSource="{Binding OperationOptions}"
                                                  SelectedItem="{Binding SelectedOperation}"
                                                  DisplayMemberBinding="{Binding Label}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Key}"
                                                 PlaceholderText="{Binding $parent[Window].((vm:BulkEditMediaViewModel)DataContext).KeyPlaceholderText}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Value}"
                                                 PlaceholderText="{Binding $parent[Window].((vm:BulkEditMediaViewModel)DataContext).ValuePlaceholderText}"
                                                 IsEnabled="{Binding IsSetOperation}" />
                                        <Button Grid.Column="3"
                                                Content="{Binding DiscardChangeText}"
                                                Command="{Binding $parent[Window].((vm:BulkEditMediaViewModel)DataContext).RemoveCustomFieldPatchCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              Margin="0,18,0,0">
            <TextBlock Text="{Binding ValidationMessage}"
                       IsVisible="{Binding HasValidationMessage}"
                       Foreground="#E0A040"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True" />
                <Button Content="{Binding ApplyText}"
                        Command="{Binding ApplyCommand}"
                        IsDefault="True"
                        Classes="accent" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
