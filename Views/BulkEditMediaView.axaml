<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Retromind.ViewModels"
        x:Class="Retromind.Views.BulkEditMediaView"
        x:DataType="vm:BulkEditMediaViewModel"
        Title="{Binding DialogTitle}"
        Width="720"
        Height="560"
        MinWidth="580"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        CanMaximize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,18">
            <TextBlock Text="{Binding ItemCountText}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding HintText}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <Border BorderBrush="#55808080"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <CheckBox Content="{Binding ChangeStatusText}"
                                  IsChecked="{Binding ChangeStatus}"
                                  VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding ChangeStatus}"
                                  MinWidth="180"
                                  HorizontalAlignment="Left" />
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CustomFieldsTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{Binding AddCustomFieldText}"
                                Command="{Binding AddCustomFieldPatchCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding CustomFieldsHint}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding CustomFieldPatches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BulkCustomFieldPatchRow">
                                <Grid ColumnDefinitions="120,*,*,Auto"
                                      ColumnSpacing="8"
                                      Margin="0,0,0,7">
                                    <ComboBox ItemsSource="{Binding OperationOptions}"
                                              SelectedItem="{Binding SelectedOperation}"
                                              DisplayMemberBinding="{Binding Label}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Key}"
                                             PlaceholderText="{Binding $parent[Window].((vm:BulkEditMediaViewModel)DataContext).KeyPlaceholderText}" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Value}"
                                             PlaceholderText="{Binding $parent[Window].((vm:BulkEditMediaViewModel)DataContext).ValuePlaceholderText}"
                                             IsEnabled="{Binding IsSetOperation}" />
                                    <Button Grid.Column="3"
                                            Content="{Binding DiscardChangeText}"
                                            Command="{Binding $parent[Window].((vm:BulkEditMediaViewModel)DataContext).RemoveCustomFieldPatchCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              Margin="0,18,0,0">
            <TextBlock Text="{Binding ValidationMessage}"
                       IsVisible="{Binding HasValidationMessage}"
                       Foreground="#E0A040"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True" />
                <Button Content="{Binding ApplyText}"
                        Command="{Binding ApplyCommand}"
                        IsDefault="True"
                        Classes="accent" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
