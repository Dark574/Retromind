<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Retromind.ViewModels"
        xmlns:p="clr-namespace:Retromind.Resources"
        xmlns:helpers="clr-namespace:Retromind.Helpers"
        x:Class="Retromind.Views.ScrapeDialogView"
        x:DataType="vm:ScrapeDialogViewModel"
        Title="{x:Static p:Strings.Metadata_SearchMetadata}"
        Width="1180" Height="700"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">

        <!-- Header / Search -->
        <Grid Grid.Row="0" RowDefinitions="Auto, Auto" ColumnDefinitions="*, 10, Auto" Margin="0,0,0,20">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static p:Strings.Dialog_ChooseSource}" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="1" Grid.Column="0"
                      ItemsSource="{Binding AvailableScrapers}"
                      SelectedItem="{Binding SelectedScraper}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static p:Strings.Dialog_SearchTerm}" Margin="0,0,0,5"/>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <TextBox Text="{Binding SearchQuery}" Width="500" />
                <Button Content="{x:Static p:Strings.Search_Search}" Command="{Binding SearchCommand}" IsDefault="True"/>
            </StackPanel>
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="1" ColumnDefinitions="2.0*, 10, 2.0*, 10, 1.5*">

            <!-- List -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <ListBox ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedResult}"
                         Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="60, *">
                                <!-- Async thumbnail (downsampled) -->
                                <Border Grid.Column="0"
                                        Width="50"
                                        Height="70"
                                        Background="#18000000"
                                        BorderBrush="#30000000"
                                        BorderThickness="1"
                                        Margin="0,5,10,5">
                                    <Grid>
                                        <TextBlock Text="{Binding $parent[Window].((vm:ScrapeDialogViewModel)DataContext).NoCoverText}"
                                                   IsVisible="{Binding CoverUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="Gray"
                                                   FontSize="9"
                                                   Margin="3"/>
                                        <Image helpers:AsyncImageHelper.Url="{Binding CoverUrl}"
                                               helpers:AsyncImageHelper.DecodeWidth="100"
                                               IsVisible="{Binding CoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Stretch="Uniform"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ReleaseDate, StringFormat={}{0:yyyy}}"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding Platform}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="320"
                                               IsVisible="{Binding Platform}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Status message overlay (no Grid.Row to avoid undefined row issues) -->
            <TextBlock Grid.Column="0" Grid.ColumnSpan="5"
                       Text="{Binding StatusMessage}"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Background="#CCFFFFFF"
                       Padding="10"/>

            <!-- Selectable metadata comparison (middle) -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding MetadataSelectionTitle}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding MetadataSelectionHint}"
                               Opacity="0.65"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding SelectAllText}"
                                Command="{Binding SelectAllMetadataCommand}"/>
                        <Button Content="{Binding ClearSelectionText}"
                                Command="{Binding ClearMetadataSelectionCommand}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,110,*,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="1" Text="" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ExistingValueText}"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding ScraperValueText}"
                                   FontWeight="Bold"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding MetadataChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScrapeMetadataChoice">
                                <Border BorderBrush="#30000000"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,7">
                                    <Grid ColumnDefinitions="Auto,110,*,*"
                                          ColumnSpacing="8">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CurrentValue}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding IncomingValue}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Additive artwork selection (right) -->
            <ScrollViewer Grid.Column="4">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding ArtworkSelectionTitle}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding ArtworkSelectionHint}"
                               Opacity="0.65"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding SelectAllText}"
                                Command="{Binding SelectAllArtworkCommand}"/>
                        <Button Content="{Binding ClearSelectionText}"
                                Command="{Binding ClearArtworkSelectionCommand}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ArtworkChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScrapeArtworkChoice">
                                <Border BorderBrush="#30000000"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,8">
                                    <StackPanel Spacing="5">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Content="{Binding Label}"
                                                  FontWeight="Bold"/>
                                        <Image helpers:AsyncImageHelper.Url="{Binding Url}"
                                               helpers:AsyncImageHelper.DecodeWidth="500"
                                               Width="220"
                                               Height="150"
                                               Stretch="Uniform"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Selection details are loaded lazily without blocking the result list. -->
            <Border Grid.Column="2"
                    Grid.ColumnSpan="3"
                    Background="#80000000"
                    IsVisible="{Binding IsPreviewBusy}">
                <TextBlock Text="{x:Static p:Strings.Metadata_Search_InProgress}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="16"/>
            </Border>

            <!-- Loading overlay -->
            <Border Grid.Column="0" Grid.ColumnSpan="5" Background="#80000000" IsVisible="{Binding IsBusy}">
                <TextBlock Text="{x:Static p:Strings.Metadata_Search_InProgress}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="20"/>
            </Border>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="{x:Static p:Strings.Button_Cancel}" Click="CloseWindow"/>
            <Button Content="{x:Static p:Strings.Button_TakeOver}"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding !IsPreviewBusy}"
                    Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>
