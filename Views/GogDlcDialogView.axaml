<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Retromind.ViewModels"
        x:Class="Retromind.Views.GogDlcDialogView"
        x:DataType="vm:GogDlcDialogViewModel"
        Title="{Binding DialogTitleText}"
        Width="900"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        CanMaximize="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="17"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding SummaryText}"
                       Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,220,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Height="32"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding SearchPlaceholderText}" />
            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      Height="32"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GogDlcFilterOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Content="{Binding RefreshText}"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="4"
                    IsVisible="{Binding ShowList}">
                <ListBox ItemsSource="{Binding FilteredDlcs}"
                         Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GogDlcCatalogEntry">
                            <Grid ColumnDefinitions="*,240" Margin="5,4">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProductId}"
                                               FontSize="11"
                                               Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding InstallerPlatformsText}"
                                           TextTrimming="CharacterEllipsis"
                                           Opacity="0.8" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel IsVisible="{Binding IsLoading}"
                        Width="320"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="5" />
                <TextBlock Text="{Binding LoadingText}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasError}"
                        MaxWidth="600"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button Content="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock IsVisible="{Binding ShowEmptyState}"
                       Text="{Binding EmptyStateText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.75" />
        </Grid>

        <Button Grid.Row="3"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Content="{Binding CloseText}"
                Command="{Binding CloseCommand}"
                IsCancel="True" />
    </Grid>
</Window>
