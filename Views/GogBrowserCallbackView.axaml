<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Retromind.Resources"
        x:Class="Retromind.Views.GogBrowserCallbackView"
        Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid Margin="20"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="12">
        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="0"
                   FontSize="16"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock x:Name="CallbackUrlLabel" />
            <TextBox x:Name="CallbackUrlBox"
                     PlaceholderText="https://embed.gog.com/on_login_success?..." />
            <TextBlock x:Name="ValidationTextBlock"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       IsVisible="False" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <Button x:Name="ReopenBrowserButton"
                    Grid.Column="0"
                    Click="OnReopenBrowserClick" />
            <Button Grid.Column="2"
                    Content="{x:Static p:Strings.Button_Ok}"
                    IsDefault="True"
                    Click="OnOkClick" />
            <Button Grid.Column="3"
                    Content="{x:Static p:Strings.Button_Cancel}"
                    IsCancel="True"
                    Click="OnCancelClick" />
        </Grid>
    </Grid>
</Window>
