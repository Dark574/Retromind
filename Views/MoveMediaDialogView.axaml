<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Retromind.ViewModels"
        x:Class="Retromind.Views.MoveMediaDialogView"
        x:DataType="vm:MoveMediaDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="560"
        Height="620"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0"
                   Text="{Binding InstructionText}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5"
                Padding="6">
            <TreeView ItemsSource="{Binding RootNodes}"
                      SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <Setter x:DataType="vm:MoveMediaNodeOption"
                                Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>

                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:MoveMediaNodeOption"
                                      ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationMessage}"
                   IsVisible="{Binding HasValidationMessage}"
                   Foreground="#E0A040"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,18,0,0">
            <Button Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
            <Button Content="{Binding ApplyText}"
                    Command="{Binding ApplyCommand}"
                    IsDefault="True"
                    Classes="accent" />
        </StackPanel>
    </Grid>
</Window>
