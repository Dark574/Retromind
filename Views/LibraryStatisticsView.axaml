<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Retromind.ViewModels"
        xmlns:helpers="using:Retromind.Helpers"
        mc:Ignorable="d"
        d:DesignWidth="1050"
        d:DesignHeight="760"
        x:Class="Retromind.Views.LibraryStatisticsView"
        x:DataType="vm:LibraryStatisticsViewModel"
        Title="{Binding Title}"
        Width="1050"
        Height="760"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        CanMaximize="False">

    <Window.Resources>
        <helpers:TimeSpanToHumanReadableConverter x:Key="TimeConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.statCard">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#10000000" />
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.statLabel">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Button.rankingRow">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
        <Style Selector="Button.statCardButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#10000000" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SummaryTitle}" Opacity="0.65" Margin="0,3,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="{Binding ScopeLabel}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ScopeOptions}"
                          SelectedItem="{Binding SelectedScope}"
                          MinWidth="360"
                          MaxWidth="620"
                          MaxDropDownHeight="420">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryStatisticsScopeOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" Classes="statCard">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalItems}" Classes="statValue" />
                            <TextBlock Text="{Binding TotalItemsLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Classes="statCard">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalPlayTime, Converter={StaticResource TimeConverter}}" Classes="statValue" />
                            <TextBlock Text="{Binding TotalPlayTimeLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Classes="statCard">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalLaunches}" Classes="statValue" />
                            <TextBlock Text="{Binding TotalLaunchesLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Row="0" Grid.Column="3"
                            Classes="statCardButton"
                            Command="{Binding ApplyFilterCommand}"
                            CommandParameter="{x:Static vm:LibraryStatisticsFilterKind.Favorites}"
                            ToolTip.Tip="{Binding FilterCardToolTip}">
                        <StackPanel>
                            <TextBlock Text="{Binding FavoriteItems}" Classes="statValue" />
                            <TextBlock Text="{Binding FavoritesLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0"
                            Classes="statCardButton"
                            Command="{Binding ApplyFilterCommand}"
                            CommandParameter="{x:Static vm:LibraryStatisticsFilterKind.Completed}"
                            ToolTip.Tip="{Binding FilterCardToolTip}">
                        <StackPanel>
                            <TextBlock Text="{Binding CompletedItems}" Classes="statValue" />
                            <TextBlock Text="{Binding CompletedLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1"
                            Classes="statCardButton"
                            Command="{Binding ApplyFilterCommand}"
                            CommandParameter="{x:Static vm:LibraryStatisticsFilterKind.InProgress}"
                            ToolTip.Tip="{Binding FilterCardToolTip}">
                        <StackPanel>
                            <TextBlock Text="{Binding InProgressItems}" Classes="statValue" />
                            <TextBlock Text="{Binding InProgressLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="2"
                            Classes="statCardButton"
                            Command="{Binding ApplyFilterCommand}"
                            CommandParameter="{x:Static vm:LibraryStatisticsFilterKind.Abandoned}"
                            ToolTip.Tip="{Binding FilterCardToolTip}">
                        <StackPanel>
                            <TextBlock Text="{Binding AbandonedItems}" Classes="statValue" />
                            <TextBlock Text="{Binding AbandonedLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="3"
                            Classes="statCardButton"
                            Command="{Binding ApplyFilterCommand}"
                            CommandParameter="{x:Static vm:LibraryStatisticsFilterKind.NeverStarted}"
                            ToolTip.Tip="{Binding FilterCardToolTip}">
                        <StackPanel>
                            <TextBlock Text="{Binding NeverStartedItems}" Classes="statValue" />
                            <TextBlock Text="{Binding NeverStartedLabel}" Classes="statLabel" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding MostPlayedTitle}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding NoPlayDataText}"
                                       Opacity="0.65"
                                       IsVisible="{Binding !HasMostPlayedItems}" />
                            <ItemsControl ItemsSource="{Binding MostPlayedItems}"
                                          IsVisible="{Binding HasMostPlayedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryStatisticsRankingItem">
                                        <Button Classes="rankingRow"
                                                Command="{Binding $parent[Window].((vm:LibraryStatisticsViewModel)DataContext).OpenItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding $parent[Window].((vm:LibraryStatisticsViewModel)DataContext).OpenItemToolTip}">
                                            <Grid ColumnDefinitions="32,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" Opacity="0.55" />
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PlayTime}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding RecentlyPlayedTitle}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding NoPlayDataText}"
                                       Opacity="0.65"
                                       IsVisible="{Binding !HasRecentlyPlayedItems}" />
                            <ItemsControl ItemsSource="{Binding RecentlyPlayedItems}"
                                          IsVisible="{Binding HasRecentlyPlayedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryStatisticsRankingItem">
                                        <Button Classes="rankingRow"
                                                Command="{Binding $parent[Window].((vm:LibraryStatisticsViewModel)DataContext).OpenItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding $parent[Window].((vm:LibraryStatisticsViewModel)DataContext).OpenItemToolTip}">
                                            <Grid ColumnDefinitions="32,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" Opacity="0.55" />
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding LastPlayed}" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="section">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DistributionLabel}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding DistributionOptions}"
                                      SelectedItem="{Binding SelectedDistribution}"
                                      MinWidth="190">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryStatisticsDistributionOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{Binding NoDistributionDataText}"
                                   Opacity="0.65"
                                   IsVisible="{Binding !HasDistributionData}" />
                        <ItemsControl ItemsSource="{Binding DistributionItems}"
                                      IsVisible="{Binding HasDistributionData}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryStatisticsDistributionItem">
                                    <StackPanel Margin="0,3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Opacity="0.7" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage}" Height="5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="{Binding CloseButtonText}"
                Command="{Binding CloseCommand}"
                CommandParameter="{Binding $parent[Window]}"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0,14,0,0" />
    </Grid>
</Window>
