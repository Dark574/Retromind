<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retromind.ViewModels"
             xmlns:ext="clr-namespace:Retromind.Extensions;assembly=Retromind"
             xmlns:helpers="using:Retromind.Helpers"
             xmlns:resources="using:Retromind.Resources"
             xmlns:video="using:Retromind.Helpers.Video"
             x:DataType="vm:BigModeViewModel"
             Background="#111319"
             
             ext:ThemeProperties.Name="Default"
             ext:ThemeProperties.Author="Retromind"
             ext:ThemeProperties.Version="0.4.0"
             ext:ThemeProperties.SupportsHome="True"
             ext:ThemeProperties.PrimaryVideoEnabled="True"
             ext:ThemeProperties.VideoSlotName="VideoSlot"
             ext:ThemeProperties.VideoFadeDurationMs="600"
             ext:ThemeProperties.FadeDurationMs="4000"
             ext:ThemeProperties.MoveDurationMs="1100"
             ext:ThemeProperties.PrimaryVisualElementName="CoverPanel"
             ext:ThemeProperties.PrimaryVisualEnterMode="SlideFromLeft"
             ext:ThemeProperties.PrimaryVisualEnterOffsetX="-420"
             ext:ThemeProperties.PrimaryVisualEnterOffsetY="0"
             ext:ThemeProperties.BackgroundVisualElementName="BackgroundVisual"
             ext:ThemeProperties.BackgroundVisualEnterMode="None">

    <UserControl.Resources>
        <x:Double x:Key="LogoHeight">80</x:Double>

        <!-- Soft slide+fade animation for the main title -->
        <Transitions x:Key="TitleTransitions">
            <DoubleTransition Property="{x:Static Visual.OpacityProperty}"
                              Duration="0:0:0.80" />
            <TransformOperationsTransition Property="{x:Static Visual.RenderTransformProperty}"
                                           Duration="0:0:0.80" />
        </Transitions>

        <!-- Playtime formatting -->
        <helpers:TimeSpanToHumanReadableConverter x:Key="TimeConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox.bm-nav-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Styles>
    
    <!-- Background layer + actual content -->
    <Grid>
        <!-- Use a screenshot only when the current game has no wallpaper. -->
        <ext:CrossfadeImage Url="{Binding ActiveScreenshotFallbackPath}"
                            DecodeWidth="1920"
                            DisableCache="True"
                            LoadDelayMs="220"
                            FadeDurationMs="700"
                            Stretch="UniformToFill"
                            Opacity="0.30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ActiveScreenshotFallbackPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}"
                            IsHitTestVisible="False" />

        <!-- Very transparent wallpaper from the current item -->
        <ext:CrossfadeImage x:Name="BackgroundVisual"
                            Url="{Binding ActiveWallpaperPath}"
                            DecodeWidth="1920"
                            DisableCache="True"
                            LoadDelayMs="220"
                            FadeDurationMs="700"
                            Stretch="UniformToFill"
                            Opacity="0.30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ActiveWallpaperPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}"
                            IsHitTestVisible="False" />

        <!-- Two-column layout: navigation on the left, video + details on the right -->
        <Grid ColumnDefinitions="0.24*,0.76*"
              Margin="32,24">

            <!-- LEFT COLUMN: category, big title, list -->
            <Border Grid.Column="0"
                    Background="#CC20232A"
                    CornerRadius="8"
                    Padding="24,28,20,24">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!-- Category label -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding CategoryTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#7BA3FF"
                               Margin="0,0,0,12"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Selected game or category identity -->
                    <Border Grid.Row="1"
                            MinHeight="{StaticResource LogoHeight}"
                            Margin="0,0,0,24">
                        <Grid>
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding IsGameListActive}">
                            <!-- Item logo only -->
                            <Grid MinHeight="{StaticResource LogoHeight}"
                                  IsVisible="{Binding SelectedItem.ItemLogoPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}">
                                <ext:CrossfadeImage Url="{Binding SelectedItem.PrimaryLogoPath}"
                                                    DecodeWidth="512"
                                                    DisableCache="True"
                                                    FadeDelayMs="120"
                                                    FadeDurationMs="1000"
                                                    MaxHeight="{StaticResource LogoHeight}"
                                                    Stretch="Uniform"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center">
                                    <ext:CrossfadeImage.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </ext:CrossfadeImage.RenderTransform>
                                    <ext:CrossfadeImage.Transitions>
                                        <StaticResource ResourceKey="TitleTransitions" />
                                    </ext:CrossfadeImage.Transitions>
                                </ext:CrossfadeImage>
                            </Grid>

                            <!-- No item-logo: show optional node fallback logo first, then title -->
                            <StackPanel Spacing="2"
                                        IsVisible="{Binding SelectedItem.ItemLogoPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}">
                                <ext:CrossfadeImage Url="{Binding ActiveLogoPath}"
                                                    DecodeWidth="512"
                                                    DisableCache="True"
                                                    FadeDelayMs="120"
                                                    FadeDurationMs="1000"
                                                    MaxHeight="40"
                                                    Stretch="Uniform"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ActiveLogoPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}">
                                    <ext:CrossfadeImage.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </ext:CrossfadeImage.RenderTransform>
                                    <ext:CrossfadeImage.Transitions>
                                        <StaticResource ResourceKey="TitleTransitions" />
                                    </ext:CrossfadeImage.Transitions>
                                </ext:CrossfadeImage>

                                <TextBlock Text="{Binding SelectedItem.Title}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Transitions>
                                        <StaticResource ResourceKey="TitleTransitions" />
                                    </TextBlock.Transitions>
                                </TextBlock>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6"
                                        IsVisible="{Binding IsCategorySelectionActive}">
                                <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryLogoAbsolutePath}"
                                                    DecodeWidth="512"
                                                    DisableCache="True"
                                                    LoadDelayMs="220"
                                                    FadeDurationMs="1000"
                                                    MaxHeight="{StaticResource LogoHeight}"
                                                    Stretch="Uniform"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding SelectedCategory.PrimaryLogoAbsolutePath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                                <TextBlock Text="{Binding SelectedCategory.Name}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding SelectedCategory.PrimaryLogoAbsolutePath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: categories OR games depending on view mode -->

                    <!-- Category list (e.g. systems) -->
                    <ListBox Grid.Row="2"
                             Classes="bm-nav-list"
                             ItemsSource="{Binding CurrentCategories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="#6620232A"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ext:ThemeProperties.FadeDurationMs="220"
                             ext:ThemeProperties.MoveDurationMs="220"
                             ext:ThemeProperties.AccentColor="#7BA3FF"
                             ext:ThemeProperties.SelectedScale="1.02"
                             ext:ThemeProperties.UnselectedOpacity="0.78"
                             ext:ThemeProperties.SelectedGlowOpacity="0.30"
                             ext:ThemeProperties.SelectedGlowRadius="14"
                             helpers:ListBoxBehaviors.CenterSelectedItem="True"
                             IsVisible="{Binding IsCategorySelectionActive}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Game list -->
                    <ListBox Grid.Row="2"
                             Classes="bm-nav-list"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="#6620232A"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ext:ThemeProperties.FadeDurationMs="220"
                             ext:ThemeProperties.MoveDurationMs="220"
                             ext:ThemeProperties.AccentColor="#7BA3FF"
                             ext:ThemeProperties.SelectedScale="1.02"
                             ext:ThemeProperties.UnselectedOpacity="0.78"
                             ext:ThemeProperties.SelectedGlowOpacity="0.30"
                             ext:ThemeProperties.SelectedGlowRadius="14"
                             helpers:ListBoxBehaviors.CenterSelectedItem="True"
                             IsVisible="{Binding IsGameListActive}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="18"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,4,0"
                                IsVisible="{Binding IsGameListActive}">
                        <TextBlock Text="{Binding CurrentGameNumber}"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text=" / "
                                   Foreground="#80FFFFFF"
                                   FontSize="16" />
                        <TextBlock Text="{Binding TotalGames}"
                                   Foreground="#C8D2E5"
                                   FontSize="16" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: big video on top + details below -->
            <Grid Grid.Column="1"
                  Margin="28,0,0,0">
                <Border Background="#CC181A20"
                        CornerRadius="8"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                    <!-- Single container grid for video (top) and details (bottom) -->
                    <Grid RowDefinitions="2*,*">
                        <!-- VIDEO AREA -->
                        <Grid Grid.Row="0">
                            <!-- Stable artwork layer shown underneath the video surface. -->
                            <Border Background="#181A20"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Grid>
                                    <ext:CrossfadeImage Url="{Binding SelectedItem.PrimaryScreenshotPath}"
                                                        DecodeWidth="1280"
                                                        DisableCache="True"
                                                        LoadDelayMs="220"
                                                        FadeDurationMs="700"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        Stretch="UniformToFill"
                                                        IsVisible="{Binding IsGameListActive}" />

                                    <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryWallpaperAbsolutePath}"
                                                        DecodeWidth="1280"
                                                        DisableCache="True"
                                                        LoadDelayMs="220"
                                                        FadeDurationMs="700"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        Stretch="UniformToFill"
                                                        IsVisible="{Binding IsCategorySelectionActive}" />

                                    <Rectangle Fill="#26000000" />

                                    <Border Background="#B0181A20"
                                            CornerRadius="12"
                                            Padding="16,9"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding !MainVideoHasContent}">
                                        <TextBlock Text="{x:Static resources:ThemeStrings.NoPreviewVideo}"
                                                   Foreground="#C8D2E5"
                                                   FontSize="16" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- The host replaces this slot's content with the VLC surface. -->
                            <Border x:Name="VideoSlot"
                                    Background="#181A20"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsVisible="{Binding IsVideoVisible}" />

                            <!-- Cover overlay -->
                            <Border x:Name="CoverPanel"
                                    Width="220"
                                    Height="330"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="-58,28,0,0"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    Background="#00000000"
                                    IsHitTestVisible="False">
                                <Grid>
                                    <Image helpers:AsyncImageHelper.Url="{Binding SelectedItem.PrimaryCoverPath}"
                                           helpers:AsyncImageHelper.DecodeWidth="600"
                                           helpers:AsyncImageHelper.DisableCache="True"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsGameListActive}" />

                                    <Image helpers:AsyncImageHelper.Url="{Binding SelectedCategory.PrimaryCoverAbsolutePath}"
                                           helpers:AsyncImageHelper.DecodeWidth="600"
                                           helpers:AsyncImageHelper.DisableCache="True"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsCategorySelectionActive}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- DETAILS: always fill the available width of the right column -->
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Background="#E020232A"
                                CornerRadius="6"
                                Padding="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="10"
                                          IsVisible="{Binding IsGameListActive}">
                                    <!-- Compact RetroAchievements summary -->
                                    <Border Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Background="#6620232A"
                                            BorderBrush="#557BA3FF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            IsVisible="{Binding RetroAchievementsProgress.IsVisible}">
                                        <StackPanel Spacing="5">
                                            <Grid ColumnDefinitions="Auto,16,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="RETROACHIEVEMENTS"
                                                           Foreground="#7BA3FF"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RetroAchievementsProgress.SummaryText}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           HorizontalAlignment="Right"
                                                           IsVisible="{Binding RetroAchievementsProgress.HasProgress}" />
                                            </Grid>
                                            <ProgressBar Minimum="0"
                                                         Maximum="{Binding RetroAchievementsProgress.ProgressMaximum}"
                                                         Value="{Binding RetroAchievementsProgress.ProgressValue}"
                                                         Height="5"
                                                         Foreground="#7BA3FF"
                                                         IsVisible="{Binding RetroAchievementsProgress.HasProgress}" />
                                            <ProgressBar IsIndeterminate="{Binding RetroAchievementsProgress.IsLoading}"
                                                         Height="4"
                                                         IsVisible="{Binding RetroAchievementsProgress.IsLoading}" />
                                            <TextBlock Text="{Binding RetroAchievementsProgress.HardcoreSummaryText}"
                                                       Foreground="#C8D2E5"
                                                       FontSize="11"
                                                       IsVisible="{Binding RetroAchievementsProgress.HasProgress}" />
                                            <TextBlock Text="{Binding RetroAchievementsProgress.StatusText}"
                                                       Foreground="#C8D2E5"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding RetroAchievementsProgress.ShowStatus}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Node / item description -->
                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Spacing="6">
                                        <TextBlock Text="{x:Static resources:Strings.Common_Description}"
                                                   Foreground="#7BA3FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />

                                        <TextBlock Text="{Binding SelectedItem.Description}"
                                                   Foreground="#DDFFFFFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Release date -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Static resources:Strings.Common_ReleaseDate}"
                                                   Foreground="#7BA3FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedItem.ReleaseDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                   Foreground="White" />
                                    </StackPanel>

                                    <!-- Developer -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Static resources:Strings.Common_Developer}"
                                                   Foreground="#7BA3FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedDeveloper}"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Played count -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Static resources:Strings.Media_PlayCount}"
                                                   Foreground="#7BA3FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedItem.PlayCount}"
                                                   Foreground="White" />
                                    </StackPanel>

                                    <!-- Last played -->
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Static resources:Strings.Media_LastPlayed}"
                                                   Foreground="#7BA3FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedItem.LastPlayed, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                   Foreground="White" />
                                    </StackPanel>

                                    <!-- Play time -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="{x:Static resources:Strings.Media_PlayTime}"
                                                   Foreground="#7BA3FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedItem.TotalPlayTime, Converter={StaticResource TimeConverter}}"
                                                   Foreground="White" />
                                    </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6"
                                                IsVisible="{Binding IsCategorySelectionActive}">
                                        <TextBlock Text="{x:Static resources:Strings.Common_Description}"
                                                   Foreground="#7BA3FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedCategory.Description}"
                                                   Foreground="#DDFFFFFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
