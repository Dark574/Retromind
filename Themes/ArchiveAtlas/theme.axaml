<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retromind.ViewModels"
             xmlns:ext="clr-namespace:Retromind.Extensions;assembly=Retromind"
             xmlns:helpers="using:Retromind.Helpers"
             xmlns:resources="clr-namespace:Retromind.Resources;assembly=Retromind"
             x:DataType="vm:BigModeViewModel"
             Background="#F3EEE4"

             ext:ThemeProperties.Name="Archive Atlas"
             ext:ThemeProperties.Author="Retromind"
             ext:ThemeProperties.Version="0.2.0"
             ext:ThemeProperties.SupportsHome="True"
             ext:ThemeProperties.ProvidesSystemMenuHint="True"
             ext:ThemeProperties.PrimaryVideoEnabled="True"
             ext:ThemeProperties.VideoSlotName="VideoSlot"
             ext:ThemeProperties.VideoFadeDurationMs="600"
             ext:ThemeProperties.VideoStretchMode="Uniform"
             ext:ThemeProperties.SecondaryVideoEnabled="True"
             ext:ThemeProperties.SecondaryVideoSlotName="BackgroundVideoSlot"
             ext:ThemeProperties.SecondaryBackgroundVideoPath="Videos/background_loop.mp4"
             ext:ThemeProperties.SelectedScale="1.03"
             ext:ThemeProperties.UnselectedOpacity="0.72"
             ext:ThemeProperties.AccentColor="#1E6F70"
             ext:ThemeProperties.TitleFontFamily="Serif"
             ext:ThemeProperties.BodyFontFamily="Sans"
             ext:ThemeProperties.CaptionFontFamily="Sans"
             ext:ThemeProperties.MonoFontFamily="Fonts/IBMPlexMono-Regular.ttf"
             ext:ThemeProperties.FadeDurationMs="250"
             ext:ThemeProperties.MoveDurationMs="160"
             ext:ThemeProperties.PrimaryVisualElementName="CoverCard"
             ext:ThemeProperties.PrimaryVisualEnterMode="None"
             ext:ThemeProperties.PrimaryVisualEnterOffsetY="140"
             ext:ThemeProperties.BackgroundVisualElementName="BackgroundVisual"
             ext:ThemeProperties.BackgroundVisualEnterMode="None"
             ext:ThemeProperties.BackgroundDimOpacity="0.15"
             ext:ThemeProperties.PanelBackgroundOpacity="0.20">

    <UserControl.Resources>
        <helpers:ThemeFontFamilyConverter x:Key="ThemeFontConverter" />
        <helpers:TimeSpanToHumanReadableConverter x:Key="TimeConverter" />

        <SolidColorBrush x:Key="InkBrush" Color="#1E1A16" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#5C534C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1E6F70" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#CFE3DD" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D6CAB8" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F8F2E7" />

        <LinearGradientBrush x:Key="PaperGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F2E8" Offset="0" />
            <GradientStop Color="#EFE7D7" Offset="0.52" />
            <GradientStop Color="#E7DDCB" Offset="1" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="AtlasGlow" Center="0.65,0.25" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F2E9DA" Offset="0.45" />
            <GradientStop Color="#E6DCC9" Offset="1" />
        </RadialGradientBrush>

        <DrawingBrush x:Key="DotPatternBrush"
                      TileMode="Tile"
                      Stretch="None"
                      DestinationRect="0,0,0.008,0.008">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2A221C" Geometry="M 2,2 h 1 v 1 h -1 z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily"
                    Value="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
                                    Path=(ext:ThemeProperties.BodyFontFamily),
                                    Converter={StaticResource ThemeFontConverter}}" />
        </Style>

        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
        </Style>

        <Style Selector="TextBlock.Mono">
            <Setter Property="FontFamily"
                    Value="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
                                    Path=(ext:ThemeProperties.MonoFontFamily),
                                    Converter={StaticResource ThemeFontConverter}}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>

        <Style Selector="TextBlock.Title">
            <Setter Property="FontFamily"
                    Value="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
                                    Path=(ext:ThemeProperties.TitleFontFamily),
                                    Converter={StaticResource ThemeFontConverter}}" />
            <Setter Property="FontSize" Value="40" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style Selector="ListBoxItem:selected Border#ItemFrame">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Background layers -->
        <Rectangle Fill="{DynamicResource PaperGradient}" />
        <Rectangle Fill="{DynamicResource AtlasGlow}" Opacity="0.45" />

        <Grid x:Name="BackgroundVisual">
            <!-- Optional background video (secondary channel) -->
            <Border x:Name="BackgroundVideoSlot"
                    Opacity="0.14"
                    ClipToBounds="True"
                    IsVisible="{Binding SecondaryVideoHasContent}" />

            <!-- Low-opacity wallpaper for item or category -->
            <ext:CrossfadeImage Url="{Binding ActiveWallpaperPath}"
                                DecodeWidth="1600"
                                DisableCache="True"
                                LoadDelayMs="220"
                                FadeDurationMs="650"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                Opacity="0.10"
                                IsVisible="{Binding ActiveWallpaperPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

            <ext:CrossfadeImage Url="{Binding ActiveScreenshotFallbackPath}"
                                DecodeWidth="1600"
                                DisableCache="True"
                                LoadDelayMs="220"
                                FadeDurationMs="650"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                Opacity="0.10"
                                IsVisible="{Binding ActiveScreenshotFallbackPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

            <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryWallpaperAbsolutePath}"
                                DecodeWidth="1600"
                                DisableCache="True"
                                LoadDelayMs="220"
                                FadeDurationMs="650"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                Opacity="0.08"
                                IsVisible="{Binding SelectedCategory.PrimaryWallpaperAbsolutePath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

        <Rectangle Fill="{DynamicResource DotPatternBrush}" Opacity="0.06" />

        <!-- Content grid -->
        <Grid ColumnDefinitions="0.25*,0.45*,0.30*" Margin="36,28">
            <!-- Left column: Index -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,20">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
                    <TextBlock Grid.Row="0"
                               Classes="Mono"
                               Text="{x:Static resources:ThemeStrings.ArchiveIndex}" />

                    <TextBlock Grid.Row="1"
                               Text="{Binding CategoryTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <Border Grid.Row="2"
                            Height="1"
                            Background="#D8CBB9" />

                    <!-- Category list -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding CurrentCategories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ext:ThemeProperties.UseHostSelectionEffects="False"
                             helpers:ListBoxBehaviors.CenterSelectedItem="True"
                             IsVisible="{Binding IsCategorySelectionActive}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemFrame"
                                        CornerRadius="10"
                                        Padding="10,7"
                                        Margin="0,3">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Game list -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             IsVisible="{Binding IsGameListActive}"
                             helpers:ListBoxBehaviors.CenterSelectedItem="True"
                             ext:ThemeProperties.UseHostSelectionEffects="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemFrame"
                                        CornerRadius="10"
                                        Padding="10,7"
                                        Margin="0,3">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="17"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="4"
                               Classes="Mono"
                               Foreground="{DynamicResource MutedInkBrush}"
                               IsVisible="{Binding IsGameListActive}">
                        <Run Text="{x:Static resources:ThemeStrings.ArchiveItem}" />
                        <Run Text=" " />
                        <Run Text="{Binding CurrentGameNumber}" />
                        <Run Text=" " />
                        <Run Text="{x:Static resources:ThemeStrings.ArchiveOf}" />
                        <Run Text=" " />
                        <Run Text="{Binding TotalGames}" />
                    </TextBlock>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                Spacing="6"
                                IsVisible="{Binding IsCategorySelectionActive}">
                        <TextBlock Text="{Binding SelectedCategory.Items.Count}"
                                   Classes="Mono"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{x:Static resources:ThemeStrings.GameCountLabel}"
                                   Classes="Mono"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                    </StackPanel>

                    <Border Grid.Row="5"
                            BorderBrush="#D8CBB9"
                            BorderThickness="0,1,0,0"
                            Padding="0,9,0,0"
                            IsVisible="{Binding !IsSystemMenuOpen}">
                        <TextBlock Text="{Binding SystemMenuHintText}"
                                   Classes="Mono"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>

            <!-- Center column: Preview + cover -->
            <Grid Grid.Column="1" Margin="20,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" MinHeight="66">
                        <StackPanel Spacing="5" IsVisible="{Binding IsGameListActive}">
                            <ext:CrossfadeImage Url="{Binding SelectedItem.PrimaryLogoPath}"
                                                DecodeWidth="512"
                                                DisableCache="True"
                                                LoadDelayMs="150"
                                                FadeDurationMs="350"
                                                RetainCurrentImageUntilLoaded="False"
                                                Height="42"
                                                Stretch="Uniform"
                                                HorizontalAlignment="Left"
                                                IsVisible="{Binding SelectedItem.ItemLogoPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                            <ext:CrossfadeImage Url="{Binding ActiveLogoPath}"
                                                DecodeWidth="384"
                                                DisableCache="True"
                                                LoadDelayMs="150"
                                                FadeDurationMs="350"
                                                RetainCurrentImageUntilLoaded="False"
                                                Height="26"
                                                Stretch="Uniform"
                                                HorizontalAlignment="Left"
                                                IsVisible="{Binding SelectedItem.ItemLogoPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />

                            <TextBlock Classes="Title"
                                       FontSize="22"
                                       Text="{Binding SelectedItem.Title}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding SelectedItem.ItemLogoPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsCategorySelectionActive}">
                            <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryLogoAbsolutePath}"
                                                DecodeWidth="512"
                                                DisableCache="True"
                                                LoadDelayMs="150"
                                                FadeDurationMs="350"
                                                RetainCurrentImageUntilLoaded="False"
                                                Height="34"
                                                Stretch="Uniform"
                                                HorizontalAlignment="Left"
                                                IsVisible="{Binding SelectedCategory.PrimaryLogoAbsolutePath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="Title"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding SelectedCategory.Name}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#EDE4D7"
                            BorderBrush="#D8CBB9"
                            BorderThickness="1"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Margin="0,12,0,0">
                        <Grid>
                            <ext:CrossfadeImage Url="{Binding SelectedItem.PrimaryScreenshotPath}"
                                                DecodeWidth="1280"
                                                DisableCache="True"
                                                LoadDelayMs="200"
                                                FadeDurationMs="550"
                                                RetainCurrentImageUntilLoaded="False"
                                                Stretch="UniformToFill"
                                                IsVisible="{Binding IsGameListActive}" />

                            <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryWallpaperAbsolutePath}"
                                                DecodeWidth="1280"
                                                DisableCache="True"
                                                LoadDelayMs="200"
                                                FadeDurationMs="550"
                                                RetainCurrentImageUntilLoaded="False"
                                                Stretch="UniformToFill"
                                                IsVisible="{Binding IsCategorySelectionActive}" />

                            <Border Background="#DDF8F2E7"
                                    BorderBrush="#80D8CBB9"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="14,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !MainVideoHasContent}">
                                <TextBlock Text="{x:Static resources:ThemeStrings.NoPreviewVideo}"
                                           Classes="Muted"
                                           FontSize="15" />
                            </Border>

                            <!-- The host places the shared video presentation in this layer. -->
                            <Border x:Name="VideoSlot"
                                    Background="Transparent"
                                    CornerRadius="18"
                                    ClipToBounds="True"
                                    IsVisible="{Binding IsVideoVisible}" />
                        </Grid>
                    </Border>

                    <!-- Cover card overlay, with logo/title fallback for missing covers. -->
                    <Border Grid.Row="1"
                            x:Name="CoverCard"
                            Width="230"
                            Height="345"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="8"
                            Margin="-36,42,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            ClipToBounds="True">
                        <Grid>
                            <Panel IsVisible="{Binding IsGameListActive}">
                                <ext:CrossfadeImage Url="{Binding SelectedItem.PrimaryCoverPath}"
                                                    DecodeWidth="420"
                                                    DisableCache="True"
                                                    LoadDelayMs="160"
                                                    FadeDurationMs="420"
                                                    RetainCurrentImageUntilLoaded="False"
                                                    Stretch="Uniform" />
                                <StackPanel Spacing="12"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedItem.PrimaryCoverPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}">
                                    <ext:CrossfadeImage Url="{Binding ActiveLogoPath}"
                                                        DecodeWidth="320"
                                                        DisableCache="True"
                                                        LoadDelayMs="160"
                                                        FadeDurationMs="420"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        MaxHeight="100"
                                                        Stretch="Uniform" />
                                    <TextBlock Text="{Binding SelectedItem.Title}"
                                               Classes="Title"
                                               FontSize="20"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxLines="4"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Panel>

                            <Panel IsVisible="{Binding IsCategorySelectionActive}">
                                <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryCoverAbsolutePath}"
                                                    DecodeWidth="420"
                                                    DisableCache="True"
                                                    LoadDelayMs="160"
                                                    FadeDurationMs="420"
                                                    RetainCurrentImageUntilLoaded="False"
                                                    Stretch="Uniform" />
                                <StackPanel Spacing="12"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedCategory.PrimaryCoverAbsolutePath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}">
                                    <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryLogoAbsolutePath}"
                                                        DecodeWidth="320"
                                                        DisableCache="True"
                                                        LoadDelayMs="160"
                                                        FadeDurationMs="420"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        MaxHeight="100"
                                                        Stretch="Uniform" />
                                    <TextBlock Text="{Binding SelectedCategory.Name}"
                                               Classes="Title"
                                               FontSize="20"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxLines="4"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Panel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="0,12,0,0"
                                IsVisible="{Binding IsGameListActive}">
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="6"
                                Padding="9,5"
                                IsVisible="{Binding SelectedYear, Converter={x:Static helpers:ObjectConverters.IsNotNull}}">
                            <TextBlock Foreground="#F7F2E8"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedYear}" />
                        </Border>
                        <Border Background="#1F1A17"
                                CornerRadius="6"
                                Padding="9,5"
                                IsVisible="{Binding SelectedDeveloper, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Foreground="#E8DFC9"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedDeveloper}" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9,5"
                            IsVisible="{Binding IsCategorySelectionActive}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SelectedCategory.Items.Count}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{x:Static resources:ThemeStrings.GameCountLabel}"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedInkBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right column: Details -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,20"
                    Margin="10,0,0,0">
                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <TextBlock Grid.Row="0"
                               Text="{x:Static resources:ThemeStrings.ArchiveDetails}"
                               Classes="Mono" />

                    <Grid Grid.Row="1">
                        <Grid RowDefinitions="Auto,*,Auto,Auto"
                              RowSpacing="14"
                              IsVisible="{Binding IsGameListActive}">
                            <TextBlock Grid.Row="0"
                                       Classes="Title"
                                       FontSize="30"
                                       Text="{Binding SelectedItem.Title}"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Grid.Row="1"
                                    Background="#72FFFFFF"
                                    BorderBrush="#A8D8CBB9"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    ClipToBounds="True">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsHitTestVisible="False"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScroll="True"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollSpeed="4.5"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollStartDelayMs="7000"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollEndPauseMs="1400"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollRestartToken="{Binding SelectedItem.Description}">
                                    <TextBlock Text="{Binding SelectedItem.Description}"
                                               Classes="Muted"
                                               FontSize="16"
                                               LineHeight="24"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="Mono" Text="{x:Static resources:ThemeStrings.ArchiveGenre}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="15" Text="{Binding SelectedItem.Genre}" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="Mono" Text="{x:Static resources:ThemeStrings.ArchivePlayers}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="15" Text="{Binding SelectedItem.MaxPlayers}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="Mono" Text="{x:Static resources:ThemeStrings.ArchiveRating}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="15" Text="{Binding SelectedItem.Rating}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="Mono" Text="{x:Static resources:ThemeStrings.ArchiveStatus}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="15" Text="{Binding SelectedItem.Status}" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Border Grid.Row="3"
                                    BorderBrush="#D8CBB9"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,0">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="Mono" Text="{x:Static resources:ThemeStrings.ArchivePlayCount}" />
                                        <TextBlock FontSize="15" Text="{Binding SelectedItem.PlayCount}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="Mono" Text="{x:Static resources:ThemeStrings.ArchiveLastPlayed}" />
                                        <TextBlock FontSize="15"
                                                   Text="{Binding SelectedItem.LastPlayed, StringFormat={}{0:yyyy-MM-dd}}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Classes="Mono" Text="{x:Static resources:ThemeStrings.ArchiveTotalPlayTime}" />
                                        <TextBlock FontSize="15"
                                                   Text="{Binding SelectedItem.TotalPlayTime, Converter={StaticResource TimeConverter}}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="14"
                              IsVisible="{Binding IsCategorySelectionActive}">
                            <TextBlock Grid.Row="0"
                                       Classes="Title"
                                       FontSize="30"
                                       Text="{Binding SelectedCategory.Name}"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Grid.Row="1"
                                    Background="#72FFFFFF"
                                    BorderBrush="#A8D8CBB9"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    ClipToBounds="True">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsHitTestVisible="False"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScroll="True"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollSpeed="4.5"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollStartDelayMs="7000"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollEndPauseMs="1400"
                                              helpers:ScrollViewerBehaviors.AutoVerticalScrollRestartToken="{Binding SelectedCategory.Description}">
                                    <TextBlock Text="{Binding SelectedCategory.Description}"
                                               Classes="Muted"
                                               FontSize="16"
                                               LineHeight="24"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
