<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retromind.ViewModels"
             xmlns:helpers="clr-namespace:Retromind.Helpers"
             xmlns:ext="clr-namespace:Retromind.Extensions;assembly=Retromind"
             xmlns:resources="clr-namespace:Retromind.Resources"
             x:DataType="vm:BigModeViewModel"
             x:Name="BigModeRoot"
             Background="Black"

             ext:ThemeProperties.Name="Wheel"
             ext:ThemeProperties.Author="Retromind"
             ext:ThemeProperties.Version="0.2.0"
             ext:ThemeProperties.SupportsHome="True"
             ext:ThemeProperties.ProvidesSystemMenuHint="True"
             ext:ThemeProperties.AccentColor="#FFD700"
             ext:ThemeProperties.BackgroundDimOpacity="0.30"
             ext:ThemeProperties.TitleFontSize="48"
             ext:ThemeProperties.BodyFontSize="18"
             ext:ThemeProperties.FadeDurationMs="4000"
             ext:ThemeProperties.MoveDurationMs="250"
             ext:ThemeProperties.CircularWindowSize="9"
             ext:ThemeProperties.PrimaryVideoEnabled="True"
             ext:ThemeProperties.VideoSlotName="VideoSlot"
             ext:ThemeProperties.VideoFadeDurationMs="600"
             ext:ThemeProperties.VideoCornerRadius="8"
             ext:ThemeProperties.VideoBorderThickness="0"
             ext:ThemeProperties.VideoStretchMode="Uniform"
             ext:ThemeProperties.BackgroundVisualElementName="BackgroundVisual"
             ext:ThemeProperties.BackgroundVisualEnterMode="None">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" /> 
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Effect" Value="drop-shadow(0 0 8 #FFD700)" />
        </Style>
        <Style Selector="ListBoxItem:selected > Panel > TextBlock[IsVisible=True]">
             <Setter Property="Foreground" Value="#FFD700" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    
    <UserControl.Resources>
        <helpers:TimeSpanToHumanReadableConverter x:Key="TimeConverter" />

        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#C8CCD6" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#42FFFFFF" />
        <SolidColorBrush x:Key="InnerBorderBrush" Color="#35FFD700" />
        <SolidColorBrush x:Key="InnerPanelBrush" Color="#B20A0D13" />

        <LinearGradientBrush x:Key="HeroPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ED171B24" Offset="0" />
            <GradientStop Color="#E30B0E14" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BackgroundWash" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B8000000" Offset="0" />
            <GradientStop Color="#70000000" Offset="0.34" />
            <GradientStop Color="#C9080A0F" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    
    <Panel>
        <!-- LAYER 1: Background -->
        <Grid x:Name="BackgroundVisual">
            <!-- Wallpaper for Games-View -->
            <ext:CrossfadeImage Name="GameWallpaper"
                                Url="{Binding ActiveWallpaperPath}"
                                DecodeWidth="1920"
                                DisableCache="True"
                                LoadDelayMs="200"
                                FadeDurationMs="650"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                IsVisible="{Binding IsGameListActive}"
                                Opacity="{Binding ElementName=BigModeRoot, Path=(ext:ThemeProperties.BackgroundDimOpacity)}" />

            <ext:CrossfadeImage Url="{Binding ActiveScreenshotFallbackPath}"
                                DecodeWidth="1920"
                                DisableCache="True"
                                LoadDelayMs="200"
                                FadeDurationMs="650"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                IsVisible="{Binding IsGameListActive}"
                                Opacity="{Binding ElementName=BigModeRoot, Path=(ext:ThemeProperties.BackgroundDimOpacity)}" />
            
            <!-- Wallpaper for Categories-View -->
            <ext:CrossfadeImage Name="CategoryWallpaper"
                                Url="{Binding ActiveCategoryWallpaperPath}"
                                DecodeWidth="1920"
                                DisableCache="True"
                                LoadDelayMs="200"
                                FadeDurationMs="650"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                IsVisible="{Binding IsCategorySelectionActive}"
                                Opacity="{Binding ElementName=BigModeRoot, Path=(ext:ThemeProperties.BackgroundDimOpacity)}" />

            <Rectangle Fill="{StaticResource BackgroundWash}" />
        </Grid>
        
        <!-- Games-Wheel -->
        <ListBox ItemsSource="{Binding WheelItems}"
                 IsVisible="{Binding IsGameListActive}"
                 Background="Transparent"
                 SelectedIndex="{Binding WheelSelectedItemIndex, Mode=OneWay}"
                 ClipToBounds="False"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Left"
                 Width="450"
                 ext:ThemeProperties.UseHostSelectionEffects="False">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <helpers:WheelPanel WheelRadius="500" 
                                        ItemSpacingAngle="18"
                                        helpers:WheelPanel.OffsetX="225"
                                        helpers:WheelPanel.SelectedScale="1.14"
                                        helpers:WheelPanel.SelectedItemIndex="{Binding $parent[ListBox].SelectedIndex}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="300" Height="140" Spacing="4" VerticalAlignment="Center">
                        <!-- Item logo (preferred) -->
                        <Image helpers:AsyncImageHelper.Url="{Binding PrimaryLogoPath}"
                               Height="80"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding ItemLogoPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Fallback logo (node-level) -->
                        <Image helpers:AsyncImageHelper.Url="{Binding PrimaryLogoPath}"
                               Height="44"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding ItemLogoPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>

                        <TextBlock Text="{Binding Title}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   IsVisible="{Binding ItemLogoPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Categories-Wheel -->
        <ListBox ItemsSource="{Binding WheelCategories}"
                 IsVisible="{Binding IsCategorySelectionActive}"
                 Background="Transparent"
                 SelectedIndex="{Binding WheelSelectedCategoryIndex, Mode=OneWay}"
                 ClipToBounds="False"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Left"
                 Width="450"
                 ext:ThemeProperties.UseHostSelectionEffects="False">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <helpers:WheelPanel WheelRadius="500" 
                                        ItemSpacingAngle="18"
                                        helpers:WheelPanel.OffsetX="225"
                                        helpers:WheelPanel.SelectedScale="1.14"
                                        helpers:WheelPanel.SelectedItemIndex="{Binding $parent[ListBox].SelectedIndex}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Panel Width="300" Height="140">
                        <!-- Category logo, if available -->
                        <Image helpers:AsyncImageHelper.Url="{Binding PrimaryLogoPath}" Stretch="Uniform"
                               IsVisible="{Binding PrimaryLogoPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        
                        <!-- Fallback: category name -->
                        <TextBlock Text="{Binding Name}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding PrimaryLogoPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- RIGHT: one coherent hero panel for media, description and metadata. -->
        <Border Margin="470,28,32,28"
                Background="{StaticResource HeroPanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28">
            <Grid RowDefinitions="Auto,*,220">
                <!-- Identity and unobtrusive navigation information. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <TextBlock Text="{Binding SelectedItem.Title}"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsGameListActive}" />

                    <TextBlock Text="{Binding SelectedCategory.Name}"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsCategorySelectionActive}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Border Background="#7110141C"
                                BorderBrush="{StaticResource InnerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,7"
                                IsVisible="{Binding IsGameListActive}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding CurrentGameNumber}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="/" Foreground="#80FFFFFF" />
                                <TextBlock Text="{Binding TotalGames}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#7110141C"
                                BorderBrush="{StaticResource InnerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,7"
                                IsVisible="{Binding IsCategorySelectionActive}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding SelectedCategory.Items.Count}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{x:Static resources:ThemeStrings.GameCountLabel}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#7110141C"
                                BorderBrush="#32FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,7"
                                IsVisible="{Binding !IsSystemMenuOpen}">
                            <TextBlock Text="{Binding SystemMenuHintText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Media and artwork share a single visual block. -->
                <Grid Grid.Row="1"
                      Margin="0,20,0,18"
                      ColumnDefinitions="*,300"
                      ColumnSpacing="24">
                    <Border Background="#F006080D"
                            BorderBrush="{StaticResource InnerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            ClipToBounds="True">
                        <Grid>
                            <ext:CrossfadeImage Url="{Binding SelectedItem.PrimaryScreenshotPath}"
                                                DecodeWidth="1280"
                                                DisableCache="True"
                                                LoadDelayMs="180"
                                                FadeDurationMs="550"
                                                RetainCurrentImageUntilLoaded="False"
                                                Stretch="UniformToFill"
                                                IsVisible="{Binding IsGameListActive}" />

                            <ext:CrossfadeImage Url="{Binding ActiveCategoryWallpaperPath}"
                                                DecodeWidth="1280"
                                                DisableCache="True"
                                                LoadDelayMs="180"
                                                FadeDurationMs="550"
                                                RetainCurrentImageUntilLoaded="False"
                                                Stretch="UniformToFill"
                                                IsVisible="{Binding IsCategorySelectionActive}" />

                            <Rectangle Fill="#35000000" />

                            <Border Background="#D012151D"
                                    BorderBrush="#32FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,9"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !MainVideoHasContent}">
                                <TextBlock Text="{x:Static resources:ThemeStrings.NoPreviewVideo}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="16" />
                            </Border>

                            <!-- The host places the shared VLC surface in this slot. -->
                            <Border x:Name="VideoSlot"
                                    Background="Transparent"
                                    CornerRadius="14"
                                    ClipToBounds="True"
                                    IsVisible="{Binding IsVideoVisible}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource InnerPanelBrush}"
                            BorderBrush="#32FFFFFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18"
                            ClipToBounds="True">
                        <Grid>
                            <Panel IsVisible="{Binding IsGameListActive}">
                                <ext:CrossfadeImage Url="{Binding SelectedItem.PrimaryCoverPath}"
                                                    DecodeWidth="600"
                                                    DisableCache="True"
                                                    LoadDelayMs="140"
                                                    FadeDurationMs="450"
                                                    RetainCurrentImageUntilLoaded="False"
                                                    Stretch="Uniform" />

                                <StackPanel Spacing="18"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedItem.PrimaryCoverPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}">
                                    <ext:CrossfadeImage Url="{Binding ActiveLogoPath}"
                                                        DecodeWidth="500"
                                                        DisableCache="True"
                                                        LoadDelayMs="140"
                                                        FadeDurationMs="450"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        MaxHeight="150"
                                                        Stretch="Uniform" />
                                    <TextBlock Text="{Binding SelectedItem.Title}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxLines="3"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Panel>

                            <Panel IsVisible="{Binding IsCategorySelectionActive}">
                                <ext:CrossfadeImage Url="{Binding SelectedCategory.PrimaryCoverAbsolutePath}"
                                                    DecodeWidth="600"
                                                    DisableCache="True"
                                                    LoadDelayMs="140"
                                                    FadeDurationMs="450"
                                                    RetainCurrentImageUntilLoaded="False"
                                                    Stretch="Uniform" />

                                <StackPanel Spacing="18"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedCategory.PrimaryCoverAbsolutePath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}">
                                    <ext:CrossfadeImage Url="{Binding ActiveCategoryLogoPath}"
                                                        DecodeWidth="500"
                                                        DisableCache="True"
                                                        LoadDelayMs="140"
                                                        FadeDurationMs="450"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        MaxHeight="150"
                                                        Stretch="Uniform" />
                                    <TextBlock Text="{Binding SelectedCategory.Name}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxLines="3"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Panel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Game details: description gets most of the width, statistics stay compact. -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,360"
                      ColumnSpacing="18"
                      IsVisible="{Binding IsGameListActive}">
                    <Border Background="{StaticResource InnerPanelBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="False"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScroll="True"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollSpeed="4.5"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollStartDelayMs="7000"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollEndPauseMs="1400"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollRestartToken="{Binding SelectedItem.Description}">
                            <TextBlock Text="{Binding SelectedItem.Description}"
                                       FontSize="17"
                                       LineHeight="25"
                                       Foreground="#E0FFFFFF"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource InnerPanelBrush}"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="18"
                              RowSpacing="12">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                <TextBlock Text="{x:Static resources:Strings.Common_ReleaseDate}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="13" />
                                <TextBlock Text="{Binding SelectedItem.ReleaseDate, StringFormat={}{0:yyyy-MM-dd}}"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Static resources:Strings.Common_Developer}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="13" />
                                <TextBlock Text="{Binding SelectedDeveloper}"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                <TextBlock Text="{x:Static resources:Strings.Media_PlayCount}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="13" />
                                <TextBlock Text="{Binding SelectedItem.PlayCount}"
                                           Foreground="White" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Static resources:Strings.Media_PlayTime}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="13" />
                                <TextBlock Text="{Binding SelectedItem.TotalPlayTime, Converter={StaticResource TimeConverter}}"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="3">
                                <TextBlock Text="{x:Static resources:Strings.Media_LastPlayed}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="13" />
                                <TextBlock Text="{Binding SelectedItem.LastPlayed, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Categories use the full detail width instead of leaving an empty stats column. -->
                <Border Grid.Row="2"
                        Background="{StaticResource InnerPanelBrush}"
                        BorderBrush="#28FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        ClipToBounds="True"
                        IsVisible="{Binding IsCategorySelectionActive}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsHitTestVisible="False"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScroll="True"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollSpeed="4.5"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollStartDelayMs="7000"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollEndPauseMs="1400"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollRestartToken="{Binding SelectedCategory.Description}">
                        <TextBlock Text="{Binding SelectedCategory.Description}"
                                   FontSize="17"
                                   LineHeight="25"
                                   Foreground="#E0FFFFFF"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
