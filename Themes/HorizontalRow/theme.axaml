<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retromind.ViewModels"
             xmlns:helpers="clr-namespace:Retromind.Helpers"
             xmlns:ext="clr-namespace:Retromind.Extensions;assembly=Retromind"
             x:DataType="vm:BigModeViewModel"
             x:Name="ThemeRoot"
             Background="Black"

             ext:ThemeProperties.Name="Horizontal Row"
             ext:ThemeProperties.Author="Retromind"
             ext:ThemeProperties.Version="0.2.0"
             ext:ThemeProperties.SupportsHome="True"
             ext:ThemeProperties.PrimaryVideoEnabled="True"
             ext:ThemeProperties.VideoSlotName="VideoSlot"
             ext:ThemeProperties.VideoStretchMode="Fill"
             ext:ThemeProperties.VideoFadeDurationMs="650"
             ext:ThemeProperties.SelectedScale="1.10"
             ext:ThemeProperties.UnselectedOpacity="0.65"
             ext:ThemeProperties.SelectedGlowOpacity="0.35"
             ext:ThemeProperties.SelectedGlowRadius="30"
             ext:ThemeProperties.AccentColor="#4BA3FF"
             ext:ThemeProperties.ProvidesSystemMenuHint="True"
             ext:ThemeProperties.SecondaryVisualElementName="LogoVisual"
             ext:ThemeProperties.SecondaryVisualEnterMode="None"
             ext:ThemeProperties.BackgroundVisualElementName="BackgroundVisual"
             ext:ThemeProperties.BackgroundVisualEnterMode="None"
             ext:ThemeProperties.FadeDurationMs="700"
             ext:ThemeProperties.MoveDurationMs="300">

    <UserControl.Resources>
        <x:Double x:Key="LogoHeight">180</x:Double>
        <x:Double x:Key="LogoWidth">860</x:Double>
        <x:Double x:Key="CoverWidth">165</x:Double>
        <x:Double x:Key="CoverHeight">245</x:Double>
        <CornerRadius x:Key="CoverRadius">12</CornerRadius>

        <helpers:BoolToScaleConverter x:Key="CardScaleConverter"
                                      NormalScale="1.0"
                                      SelectedScale="1.10" />
        <helpers:BoolToOpacityConverter x:Key="SelectedTitleOpacityConverter"
                                        TrueOpacity="1.0"
                                        FalseOpacity="0.0" />

        <SolidColorBrush x:Key="ChipBackground" Color="#A8121822" />
        <SolidColorBrush x:Key="ChipBorder" Color="#557BA3FF" />

        <LinearGradientBrush x:Key="TopFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CC000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LeftReadabilityFade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E0000000" Offset="0" />
            <GradientStop Color="#A6000000" Offset="0.38" />
            <GradientStop Color="#00000000" Offset="0.78" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CoverStripBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#18000000" Offset="0" />
            <GradientStop Color="#C4000000" Offset="0.28" />
            <GradientStop Color="#F0000000" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BackgroundShade" Color="#06000000" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem Border#CoverFrame">
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="{StaticResource CoverRadius}" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style Selector="ListBoxItem:selected Border#CoverFrame">
            <Setter Property="BorderBrush" Value="#D64BA3FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{StaticResource CoverRadius}" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- BACKGROUND: wallpaper fallback remains fullscreen -->
        <Grid x:Name="BackgroundVisual" Grid.RowSpan="2">
            <ext:CrossfadeImage Url="{Binding ActiveScreenshotFallbackPath}"
                                DecodeWidth="1920"
                                DisableCache="True"
                                LoadDelayMs="220"
                                FadeDurationMs="700"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                Opacity="0.55"
                                IsVisible="{Binding ActiveScreenshotFallbackPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

            <ext:CrossfadeImage Url="{Binding ActiveWallpaperPath}"
                                DecodeWidth="1920"
                                DisableCache="True"
                                LoadDelayMs="220"
                                FadeDurationMs="700"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                Opacity="0.55"
                                IsVisible="{Binding ActiveWallpaperPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

            <ext:CrossfadeImage Url="{Binding ActiveCategoryWallpaperPath}"
                                DecodeWidth="1920"
                                DisableCache="True"
                                LoadDelayMs="220"
                                FadeDurationMs="700"
                                RetainCurrentImageUntilLoaded="False"
                                Stretch="UniformToFill"
                                Opacity="0.55"
                                IsVisible="{Binding ActiveCategoryWallpaperPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

        <!-- Primary video is only drawn above the cover strip -->
        <Border x:Name="VideoSlot"
                Grid.Row="0"
                IsVisible="{Binding MainVideoHasContent}"
                Background="#000000"
                ClipToBounds="True" />

        <Rectangle Grid.Row="0" Fill="{StaticResource BackgroundShade}" />
        <Rectangle Grid.Row="0" Fill="{StaticResource TopFade}" VerticalAlignment="Top" Height="220" />
        <Rectangle Grid.Row="0" Fill="{StaticResource LeftReadabilityFade}" />

        <!-- TOP FOREGROUND CONTENT -->
        <Grid Grid.Row="0" Margin="48,32,48,0">
            <!-- Logo + description -->
            <StackPanel x:Name="LogoVisual" Grid.Row="0" Spacing="18" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,16">
                <!-- Game logo / title -->
                <StackPanel IsVisible="{Binding IsGameListActive}" Spacing="16" HorizontalAlignment="Left">
                    <ext:CrossfadeImage Url="{Binding ActiveLogoPath}"
                                        DecodeWidth="600"
                                        DisableCache="True"
                                        LoadDelayMs="160"
                                        RetainCurrentImageUntilLoaded="False"
                                        Stretch="Uniform"
                                        FadeDurationMs="300"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        MaxWidth="{StaticResource LogoWidth}"
                                        MaxHeight="{StaticResource LogoHeight}"
                                        IsVisible="{Binding ActiveLogoPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                    <TextBlock Text="{Binding SelectedItem.Title}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Left"
                               HorizontalAlignment="Left"
                               MaxWidth="{StaticResource LogoWidth}"
                               IsVisible="{Binding SelectedItem.ItemLogoPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                </StackPanel>

                <!-- Category logo / title -->
                <StackPanel IsVisible="{Binding IsCategorySelectionActive}" Spacing="16" HorizontalAlignment="Left">
                    <ext:CrossfadeImage Url="{Binding ActiveCategoryLogoPath}"
                                        DecodeWidth="600"
                                        DisableCache="True"
                                        LoadDelayMs="160"
                                        RetainCurrentImageUntilLoaded="False"
                                        Stretch="Uniform"
                                        FadeDurationMs="300"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        MaxWidth="{StaticResource LogoWidth}"
                                        MaxHeight="{StaticResource LogoHeight}"
                                        IsVisible="{Binding ActiveCategoryLogoPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                    <TextBlock Text="{Binding SelectedCategory.Name}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Left"
                               HorizontalAlignment="Left"
                               MaxWidth="{StaticResource LogoWidth}"
                               IsVisible="{Binding ActiveCategoryLogoPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                </StackPanel>

                <Border Margin="0,12,0,0"
                        MaxWidth="{StaticResource LogoWidth}"
                        MaxHeight="340"
                        ClipToBounds="True"
                        IsVisible="{Binding IsGameListActive}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsHitTestVisible="False"
                                  Background="Transparent"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScroll="True"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollSpeed="4.5"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollStartDelayMs="7200"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollEndPauseMs="1400"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollRestartToken="{Binding SelectedItem.Description}">
                        <TextBlock Text="{Binding SelectedItem.Description}"
                                   FontSize="18"
                                   LineHeight="27"
                                   Foreground="#DDFFFFFF"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   HorizontalAlignment="Left" />
                    </ScrollViewer>
                </Border>

                <Border Margin="0,12,0,0"
                        MaxWidth="{StaticResource LogoWidth}"
                        MaxHeight="340"
                        ClipToBounds="True"
                        IsVisible="{Binding IsCategorySelectionActive}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsHitTestVisible="False"
                                  Background="Transparent"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScroll="True"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollSpeed="4.5"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollStartDelayMs="7200"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollEndPauseMs="1400"
                                  helpers:ScrollViewerBehaviors.AutoVerticalScrollRestartToken="{Binding SelectedCategory.Description}">
                        <TextBlock Text="{Binding SelectedCategory.Description}"
                                   FontSize="18"
                                   LineHeight="27"
                                   Foreground="#DDFFFFFF"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   HorizontalAlignment="Left" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Info chips (date, developer, genre, status) -->
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsGameListActive}">
                <Border Background="{StaticResource ChipBackground}"
                        BorderBrush="{StaticResource ChipBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,5"
                        IsVisible="{Binding SelectedYear, Converter={x:Static helpers:ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding SelectedYear}"
                               FontSize="13"
                               Foreground="#E0E0E0" />
                </Border>

                <Border Background="{StaticResource ChipBackground}"
                        BorderBrush="{StaticResource ChipBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,5"
                        IsVisible="{Binding SelectedDeveloper, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding SelectedDeveloper}"
                               FontSize="13"
                               Foreground="#E0E0E0"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Border Background="{StaticResource ChipBackground}"
                        BorderBrush="{StaticResource ChipBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,5"
                        IsVisible="{Binding SelectedItem.Genre, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding SelectedItem.Genre}"
                               FontSize="13"
                               Foreground="#E0E0E0"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Border Background="{StaticResource ChipBackground}"
                        BorderBrush="{StaticResource ChipBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,5">
                    <TextBlock Text="{Binding SelectedItem.Status}"
                               FontSize="13"
                               Foreground="#E0E0E0" />
                </Border>
            </StackPanel>

            <!-- Keep the system-menu shortcut clear of the cover carousel. -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,10"
                    Padding="10,5"
                    Background="{StaticResource ChipBackground}"
                    BorderBrush="{StaticResource ChipBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    IsVisible="{Binding !IsSystemMenuOpen}">
                <TextBlock Text="{Binding SystemMenuHintText}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#E0E0E0" />
            </Border>

        </Grid>

        <!-- BOTTOM FOREGROUND CONTENT: horizontal cover row -->
        <Grid Grid.Row="1"
              Margin="0"
              VerticalAlignment="Bottom"
              Background="{StaticResource CoverStripBackground}"
              ClipToBounds="False">
            <Grid Margin="0"
                  ClipToBounds="False">

                <!-- Game list -->
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         SelectedIndex="{Binding SelectedItemIndex, Mode=OneWayToSource}"
                         IsVisible="{Binding IsGameListActive}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ClipToBounds="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         helpers:ListBoxBehaviors.CenterSelectedItemHorizontally="True"
                         helpers:ListBoxBehaviors.CenterSelectedItemHorizontallyOnceOnFirstSelection="True"
                         helpers:ListBoxBehaviors.HorizontalCenterAnimationDurationMs="110"
                         ext:ThemeProperties.UseHostSelectionEffects="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="12,18"
                                    ClipToBounds="False"
                                    RenderTransformOrigin="50%,50%">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource CardScaleConverter}}"
                                                    ScaleY="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource CardScaleConverter}}" />
                                </Border.RenderTransform>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <Border x:Name="CoverFrame"
                                            Width="{StaticResource CoverWidth}"
                                            Height="{StaticResource CoverHeight}"
                                            CornerRadius="{StaticResource CoverRadius}">
                                        <Border.BoxShadow>
                                            <MultiBinding Converter="{x:Static helpers:ObjectConverters.SelectedCoverGlow}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="IsSelected" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="(ext:ThemeProperties.SelectedGlowOpacity)" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="(ext:ThemeProperties.SelectedGlowRadius)" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="(ext:ThemeProperties.AccentColor)" />
                                            </MultiBinding>
                                        </Border.BoxShadow>
                                        <Border CornerRadius="{StaticResource CoverRadius}"
                                                Background="#1A1A1A"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image helpers:AsyncImageHelper.Url="{Binding PrimaryCoverPath}"
                                                       helpers:AsyncImageHelper.DecodeWidth="400"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding PrimaryCoverPath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E0E0E0"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Margin="8"
                                                           IsVisible="{Binding PrimaryCoverPath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <TextBlock Text="{Binding Title}"
                                               Width="{StaticResource CoverWidth}"
                                               Height="22"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Opacity="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource SelectedTitleOpacityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Category list (fallback when not in game mode) -->
                <ListBox ItemsSource="{Binding CurrentCategories}"
                         SelectedItem="{Binding SelectedCategory}"
                         SelectedIndex="{Binding SelectedCategoryIndex, Mode=OneWayToSource}"
                         IsVisible="{Binding IsCategorySelectionActive}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ClipToBounds="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         helpers:ListBoxBehaviors.CenterSelectedItemHorizontally="True"
                         helpers:ListBoxBehaviors.CenterSelectedItemHorizontallyOnceOnFirstSelection="True"
                         helpers:ListBoxBehaviors.HorizontalCenterAnimationDurationMs="110"
                         ext:ThemeProperties.UseHostSelectionEffects="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="12,18"
                                    ClipToBounds="False"
                                    RenderTransformOrigin="50%,50%">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource CardScaleConverter}}"
                                                    ScaleY="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource CardScaleConverter}}" />
                                </Border.RenderTransform>
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <Border x:Name="CoverFrame"
                                            Width="{StaticResource CoverWidth}"
                                            Height="{StaticResource CoverHeight}"
                                            CornerRadius="{StaticResource CoverRadius}">
                                        <Border.BoxShadow>
                                            <MultiBinding Converter="{x:Static helpers:ObjectConverters.SelectedCoverGlow}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="IsSelected" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="(ext:ThemeProperties.SelectedGlowOpacity)" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="(ext:ThemeProperties.SelectedGlowRadius)" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="(ext:ThemeProperties.AccentColor)" />
                                            </MultiBinding>
                                        </Border.BoxShadow>
                                        <Border CornerRadius="{StaticResource CoverRadius}"
                                                Background="#1A1A1A"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image helpers:AsyncImageHelper.Url="{Binding PrimaryCoverAbsolutePath}"
                                                       helpers:AsyncImageHelper.DecodeWidth="400"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding PrimaryCoverAbsolutePath, Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                                                <Image helpers:AsyncImageHelper.Url="{Binding PrimaryLogoAbsolutePath}"
                                                       helpers:AsyncImageHelper.DecodeWidth="400"
                                                       Stretch="Uniform"
                                                       Margin="10"
                                                       IsVisible="{Binding PrimaryCoverAbsolutePath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />

                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E0E0E0"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Margin="8"
                                                           IsVisible="{Binding PrimaryLogoAbsolutePath, Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <TextBlock Text="{Binding Name}"
                                               Width="{StaticResource CoverWidth}"
                                               Height="22"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Opacity="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource SelectedTitleOpacityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
