<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retromind.ViewModels"
             xmlns:ext="clr-namespace:Retromind.Extensions;assembly=Retromind"
             xmlns:helpers="using:Retromind.Helpers"
             xmlns:resources="clr-namespace:Retromind.Resources;assembly=Retromind"
             x:DataType="vm:BigModeViewModel"
             x:Name="ThemeRoot"
             Background="Transparent"

             ext:ThemeProperties.Name="PlayStation 1"
             ext:ThemeProperties.Author="Retromind"
             ext:ThemeProperties.Version="0.1.0"
             ext:ThemeProperties.AccentColor="#4B7FD0"
             ext:ThemeProperties.PrimaryVideoEnabled="True"
             ext:ThemeProperties.VideoSlotName="SystemPrimaryVideoSlot"
             ext:ThemeProperties.VideoStretchMode="UniformToFill"
             ext:ThemeProperties.VideoFadeDurationMs="600"
             ext:ThemeProperties.SecondaryVideoEnabled="False">

    <UserControl.Resources>
        <helpers:ThemeAssetToBitmapConverter x:Key="ThemeAssetConverter" />
    </UserControl.Resources>

    <Border Background="#0B101B"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#202B42" Offset="0" />
                        <GradientStop Color="#111827" Offset="0.48" />
                        <GradientStop Color="#070A12" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Border Background="#4B7FD0"
                    Height="4"
                    VerticalAlignment="Top"
                    Opacity="0.92" />

            <!-- Subtle disc rings reference the optical-media era without using
                 a platform logo, product lettering, or game artwork. -->
            <Border Width="430"
                    Height="430"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,72,70,0"
                    CornerRadius="215"
                    BorderBrush="#174B7FD0"
                    BorderThickness="2" />
            <Border Width="280"
                    Height="280"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,147,145,0"
                    CornerRadius="140"
                    BorderBrush="#124FD1C5"
                    BorderThickness="1" />

            <Grid ColumnDefinitions="0.82*,1.48*"
                  Margin="44,34,38,30">

                <Grid Grid.Column="0"
                      RowDefinitions="Auto,Auto,*"
                      Margin="0,12,36,10">
                    <Grid Grid.Row="0" Height="112">
                        <Image helpers:AsyncImageHelper.Url="{Binding SelectedCategory.PrimaryLogoAbsolutePath}"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               MaxWidth="370"
                               IsVisible="{Binding SelectedCategory.PrimaryLogoAbsolutePath,
                                                   Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                        <TextBlock Text="{Binding SelectedCategory.Name}"
                                   FontSize="44"
                                   FontWeight="Bold"
                                   Foreground="#F3F6FC"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding SelectedCategory.PrimaryLogoAbsolutePath,
                                                       Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,20">
                        <Border Height="3"
                                Background="#4B7FD0"
                                HorizontalAlignment="Left"
                                Width="124" />
                        <Border Height="3"
                                Background="#4FD1C5"
                                HorizontalAlignment="Left"
                                Margin="124,0,0,0"
                                Width="42" />
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="#554B7FD0"
                            BorderThickness="1,0,0,0"
                            Padding="18,2,4,4"
                            ClipToBounds="True">
                        <TextBlock Text="{Binding SelectedCategory.Description}"
                                   FontSize="18"
                                   LineHeight="27"
                                   Foreground="#D8DFEC"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <!-- The video sits behind the transparent CRT aperture. The
                     brand-neutral console and wired controllers overlap it in front. -->
                <Viewbox Grid.Column="1"
                         Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         MaxWidth="930"
                         MaxHeight="830">
                    <Canvas Width="1536" Height="1500">
                        <Border x:Name="SystemPrimaryVideoSlot"
                                Canvas.Left="250"
                                Canvas.Top="164"
                                Width="1045"
                                Height="770"
                                Background="#010205"
                                ClipToBounds="True" />

                        <Image Source="{Binding $parent[UserControl],
                                                Converter={StaticResource ThemeAssetConverter},
                                                ConverterParameter=Images/ps1-inspired-crt-frame.png}"
                               Canvas.Left="100"
                               Canvas.Top="0"
                               Width="1337"
                               Height="1176"
                               Stretch="Fill"
                               IsHitTestVisible="False" />

                        <Image Source="{Binding $parent[UserControl],
                                                Converter={StaticResource ThemeAssetConverter},
                                                ConverterParameter=Images/ps1-inspired-console-controllers.png}"
                               Canvas.Left="318"
                               Canvas.Top="860"
                               Width="900"
                               Height="600"
                               Stretch="Fill"
                               IsHitTestVisible="False" />

                        <Border Canvas.Left="675"
                                Canvas.Top="955"
                                Width="250"
                                Height="58"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <RotateTransform Angle="2" />
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Static resources:ThemeStrings.GameCountLabel}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#696C73"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedCategory.Items.Count}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#3E70BC" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
