<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Retromind.ViewModels"
             xmlns:ext="clr-namespace:Retromind.Extensions;assembly=Retromind"
             xmlns:helpers="using:Retromind.Helpers"
             xmlns:resources="clr-namespace:Retromind.Resources;assembly=Retromind"
             x:DataType="vm:BigModeViewModel"
             x:Name="ThemeRoot"
             Background="Transparent"

             ext:ThemeProperties.Name="Default System Layout"
             ext:ThemeProperties.Author="Retromind"
             ext:ThemeProperties.Version="0.2.1"
             ext:ThemeProperties.PrimaryVideoEnabled="True"
             ext:ThemeProperties.VideoSlotName="SystemPrimaryVideoSlot"
             ext:ThemeProperties.VideoFadeDurationMs="600"
             ext:ThemeProperties.SecondaryVideoEnabled="False">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#7BA3FF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#C8D2E5" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#38FFFFFF" />
        <SolidColorBrush x:Key="PreviewBorderBrush" Color="#667BA3FF" />
        <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#E00B0E15" />

        <LinearGradientBrush x:Key="BackgroundWash" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1B2638" Offset="0" />
            <GradientStop Color="#FF131D2C" Offset="0.52" />
            <GradientStop Color="#FF0D1421" Offset="1" />
        </LinearGradientBrush>

    </UserControl.Resources>

    <Border Background="#111A29"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Rectangle Fill="{StaticResource BackgroundWash}"
                       IsHitTestVisible="False" />

            <!-- Match the shared system-subtheme structure: identity and details
                 on the left, system presentation on the right. -->
            <Grid ColumnDefinitions="0.82*,1.48*"
                  Margin="44,34,38,30">

                <Grid Grid.Column="0"
                      RowDefinitions="Auto,Auto,*"
                      Margin="0,12,36,10">
                    <Grid Grid.Row="0" Height="112">
                        <ext:CrossfadeImage Url="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).PrimaryLogoAbsolutePath}"
                                            DecodeWidth="640"
                                            LoadDelayMs="180"
                                            FadeDurationMs="500"
                                            RetainCurrentImageUntilLoaded="False"
                                            MaxWidth="390"
                                            MaxHeight="108"
                                            Stretch="Uniform"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ElementName=ThemeRoot,
                                                                Path=(ext:ThemeProperties.SystemPreviewNode).PrimaryLogoAbsolutePath,
                                                                Converter={x:Static helpers:StringConverters.IsNotNullOrEmpty}}" />

                        <TextBlock Text="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).Name}"
                                   FontSize="44"
                                   LineHeight="48"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ElementName=ThemeRoot,
                                                       Path=(ext:ThemeProperties.SystemPreviewNode).PrimaryLogoAbsolutePath,
                                                       Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,20">
                        <Border Height="3"
                                Width="124"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left"
                                CornerRadius="2" />
                        <Border Height="3"
                                Width="42"
                                Margin="124,0,0,0"
                                Background="#7AFFFFFF"
                                HorizontalAlignment="Left"
                                CornerRadius="2" />
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="#557BA3FF"
                            BorderThickness="1,0,0,0"
                            Padding="18,2,4,4"
                            ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="False"
                                      Background="Transparent"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScroll="True"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollSpeed="4.2"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollStartDelayMs="6500"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollEndPauseMs="1500"
                                      helpers:ScrollViewerBehaviors.AutoVerticalScrollRestartToken="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).Description}">
                            <TextBlock Text="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).Description}"
                                       FontSize="18"
                                       LineHeight="27"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                </Grid>

                <Grid Grid.Column="1"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="18"
                      VerticalAlignment="Center">
                    <!-- Responsive 16:9 preview stage. -->
                    <Viewbox Grid.Row="0"
                             Stretch="Uniform"
                             StretchDirection="Both"
                             HorizontalAlignment="Center"
                             MaxWidth="840"
                             MaxHeight="473">
                        <Grid Width="960" Height="540">
                            <!-- Artwork remains visible until the first video frame is ready. -->
                            <Border Background="{StaticResource PreviewSurfaceBrush}"
                                    BorderBrush="{StaticResource PreviewBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Grid>
                                    <ext:CrossfadeImage Url="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).PrimaryWallpaperAbsolutePath}"
                                                        DecodeWidth="1280"
                                                        LoadDelayMs="220"
                                                        FadeDurationMs="700"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        Stretch="UniformToFill" />

                                    <Rectangle Fill="#24000000" />

                                    <ext:CrossfadeImage Url="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).PrimaryLogoAbsolutePath}"
                                                        DecodeWidth="720"
                                                        LoadDelayMs="180"
                                                        FadeDurationMs="500"
                                                        RetainCurrentImageUntilLoaded="False"
                                                        Margin="140,90"
                                                        Opacity="0.82"
                                                        Stretch="Uniform"
                                                        IsVisible="{Binding ElementName=ThemeRoot,
                                                                            Path=(ext:ThemeProperties.SystemPreviewNode).PrimaryWallpaperAbsolutePath,
                                                                            Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />

                                    <TextBlock Text="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).Name}"
                                               Foreground="White"
                                               FontSize="46"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="120"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ElementName=ThemeRoot,
                                                                   Path=(ext:ThemeProperties.SystemPreviewNode).PrimaryLogoAbsolutePath,
                                                                   Converter={x:Static helpers:StringConverters.IsNullOrEmpty}}" />

                                    <Border Background="#D0141822"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="18,10"
                                            Margin="0,0,0,24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            IsVisible="{Binding !MainVideoHasContent}">
                                        <TextBlock Text="{x:Static resources:ThemeStrings.NoSystemVideo}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="18" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- The host replaces this slot's content with the shared VLC surface. -->
                            <Border x:Name="SystemPrimaryVideoSlot"
                                    Background="{StaticResource PreviewSurfaceBrush}"
                                    BorderBrush="{StaticResource PreviewBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    ClipToBounds="True"
                                    IsVisible="{Binding IsVideoVisible}" />
                        </Grid>
                    </Viewbox>

                    <Border Grid.Row="1"
                            Padding="14,8"
                            Background="#76101620"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ElementName=ThemeRoot, Path=(ext:ThemeProperties.SystemPreviewNode).Items.Count}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <TextBlock Text="{x:Static resources:ThemeStrings.GameCountLabel}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
